---
import { t, type Locale, type UiKey } from '../lib/i18n';

interface Props {
  scores: any;
  locale?: Locale;
}

const { scores, locale = 'zh' } = Astro.props;

const dims: { key: string; labelKey: UiKey }[] = [
  { key: 'technical_impact', labelKey: 'scores.technical_impact' },
  { key: 'engineering_value', labelKey: 'scores.engineering_value' },
  { key: 'adoption_signal', labelKey: 'scores.adoption_signal' },
  { key: 'maturity', labelKey: 'scores.maturity' },
  { key: 'verification_cost', labelKey: 'scores.verification_cost' },
  { key: 'risk', labelKey: 'scores.risk' },
];
---

<div class="score-list">
  {dims.map((d) => {
    const v = scores[d.key] ?? 0;
    const color = d.key === 'risk' && v >= 4 ? 'var(--watch)' : 'var(--text)';
    return (
      <div class="score-row" title={t(locale, `scores.anchor.${d.key}` as UiKey)}>
        <span class="name">{t(locale, d.labelKey)}</span>
        <span class="track"><span class="fill" style={`width: ${(v / 5) * 100}%; background: ${color}`}></span></span>
        <span class="val">{v}</span>
      </div>
    );
  })}
</div>
