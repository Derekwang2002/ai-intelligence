---
import { u, catLabel } from '../lib/url';

interface Props {
  events: any[];
}

const { events } = Astro.props;

// 环带（内/外半径），按建议分区，最内环为 ADOPT。
const RINGS: Record<string, [number, number]> = {
  ADOPT: [30, 168],
  TRIAL: [172, 298],
  WATCH: [302, 418],
  IGNORE: [422, 468],
};
const RING_ORDER = ['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const;

// 象限为 [起始角, 结束角]（度）。SVG y 轴向下、角度自东向顺时针，
// 因此 [-90,0] 是右上楔形。
const QUADRANTS = [
  { id: 'models', label: '模型与研究', cats: ['foundation-model', 'research'], range: [-90, 0] },
  { id: 'agents', label: 'Agent 与工程', cats: ['agent-security', 'agent', 'ai-engineering'], range: [180, 270] },
  { id: 'infra', label: '基础设施与开源', cats: ['open-source', 'infrastructure'], range: [90, 180] },
  { id: 'tools', label: '工具与商业', cats: ['developer-tools', 'business'], range: [0, 90] },
];

const CX = 500;
const CY = 500;
const REC_VAR: Record<string, string> = {
  ADOPT: 'var(--adopt)',
  TRIAL: 'var(--trial)',
  WATCH: 'var(--watch)',
  IGNORE: 'var(--ignore)',
};

// Annulus path (outer circle minus inner circle) for soft ring band tints.
const annulus = (ri: number, ro: number) =>
  `M ${CX - ro} ${CY} a ${ro} ${ro} 0 1 0 ${2 * ro} 0 a ${ro} ${ro} 0 1 0 ${-2 * ro} 0 Z` +
  ` M ${CX - ri} ${CY} a ${ri} ${ri} 0 1 0 ${2 * ri} 0 a ${ri} ${ri} 0 1 0 ${-2 * ri} 0 Z`;
const RING_TINT: Record<string, number> = { ADOPT: 0.08, TRIAL: 0.05, WATCH: 0.035, IGNORE: 0.025 };

// 由 fingerprint 生成确定性伪随机数，保证每次构建光点位置稳定。
function hash01(str: string, salt: number): number {
  let h = 2166136261 ^ salt;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  h = (h ^ (h >>> 13)) >>> 0;
  return h / 4294967296;
}

// 每个 fingerprint 只保留一个光点，取最新事件。
const byFingerprint = new Map<string, any>();
for (const e of events) {
  const fp = e.event_fingerprint || e.event_id;
  const existing = byFingerprint.get(fp);
  if (!existing || String(e.published_date) > String(existing.published_date)) byFingerprint.set(fp, e);
}

type Blip = {
  no: number;
  x: number;
  y: number;
  rec: string;
  title: string;
  org: string;
  date: string;
  href: string;
};

const legend: { quad: (typeof QUADRANTS)[number]; blips: Blip[] }[] = [];
let counter = 0;
for (const quad of QUADRANTS) {
  const quadEvents = [...byFingerprint.values()]
    .filter((e) => quad.cats.includes(e.category))
    .sort((a, b) => String(a.published_date).localeCompare(String(b.published_date)));
  const blips: Blip[] = [];
  for (const e of quadEvents) {
    counter += 1;
    const [ri, ro] = RINGS[e.recommendation] ?? RINGS.WATCH;
    const [qs, qe] = quad.range;
    const t1 = 0.12 + 0.76 * hash01(e.event_fingerprint, 1);
    const t2 = 0.2 + 0.6 * hash01(e.event_fingerprint, 2);
    const angle = ((qs + (qe - qs) * t1) * Math.PI) / 180;
    const radius = ri + (ro - ri) * t2;
    blips.push({
      no: counter,
      x: CX + radius * Math.cos(angle),
      y: CY + radius * Math.sin(angle),
      rec: e.recommendation,
      title: e.title,
      org: (e.organization ?? []).join(', '),
      date: e.published_date,
      href: u(`/events/${e.event_id}/`),
    });
  }
  legend.push({ quad, blips });
}

const ringMid = (r: keyof typeof RINGS) => (RINGS[r][0] + RINGS[r][1]) / 2;
const quadLabelPos = (range: [number, number]) => {
  const mid = ((range[0] + range[1]) / 2) * (Math.PI / 180);
  const r = 512;
  return { x: CX + r * Math.cos(mid), y: CY + r * Math.sin(mid) };
};
---

<div class="radar-wrap">
  <div class="card" style="padding: 18px;">
    <svg class="radar-svg" viewBox="0 0 1000 1000" role="img" aria-label="AI 情报观察站技术雷达">
      {RING_ORDER.map((r) => (
        <path class="ring-band" d={annulus(RINGS[r][0], RINGS[r][1])} fill={REC_VAR[r]} fill-rule="evenodd" opacity={RING_TINT[r]} />
      ))}
      {RING_ORDER.map((r) => (
        <circle class="ring-line" cx={CX} cy={CY} r={RINGS[r][1]} />
      ))}
      <circle class="ring-line" cx={CX} cy={CY} r={RINGS.ADOPT[0]} opacity="0.5" />
      <line class="axis-line" x1={CX} y1={26} x2={CX} y2={974} />
      <line class="axis-line" x1="26" y1={CY} x2="974" y2={CY} />

      {RING_ORDER.map((r) => (
        <text class="ring-label" x={CX} y={CY - ringMid(r) + 6}>{r}</text>
      ))}

      {QUADRANTS.map((q) => {
        const p = quadLabelPos(q.range as unknown as [number, number]);
        return <text class="quad-label" x={p.x} y={p.y} text-anchor="middle">{q.label}</text>;
      })}

      {legend.flatMap(({ blips }) =>
        blips.map((b) => (
          <a class="blip" href={b.href} aria-label={`${b.title}（${b.rec}）`} data-tip-title={b.title} data-tip-meta={`${b.org} · ${b.date} · ${b.rec}`}>
            <circle cx={b.x} cy={b.y} r="12" fill={REC_VAR[b.rec] ?? REC_VAR.WATCH} />
            <text x={b.x} y={b.y + 0.5}>{b.no}</text>
          </a>
        ))
      )}
    </svg>
  </div>

  <aside class="radar-legend">
    {legend.map(({ quad, blips }) => (
      <div>
        <h3>{quad.label}<span class="count">{blips.length}</span></h3>
        <div class="items">
          {blips.length === 0 && <span style="font-size: 12.5px; color: var(--text-faint); padding: 4px 8px;">暂无条目</span>}
          {blips.map((b) => (
            <a href={b.href} data-tip-title={b.title} data-tip-meta={`${b.org} · ${b.date} · ${b.rec}`}>
              <span class="no">{String(b.no).padStart(2, '0')}</span>
              <span class="rec-dot" style={`background: ${REC_VAR[b.rec] ?? REC_VAR.WATCH}`}></span>
              <span>{b.title.length > 58 ? b.title.slice(0, 55) + '…' : b.title}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
    <div class="radar-legend-foot">
      {RING_ORDER.map((r) => (
        <span class="legend-sw"><i style={`background: ${REC_VAR[r]}`}></i>{r}</span>
      ))}
      <span style="width: 100%; color: var(--text-faint);">内环 → 外环，建议强度递减</span>
    </div>
  </aside>
</div>

<div class="radar-tip" id="radar-tip" aria-hidden="true">
  <div class="t"></div>
  <div class="m"></div>
</div>

<script>
  const svg = document.querySelector('.radar-svg');
  const tip = document.getElementById('radar-tip');

  function show(target: Element, clientX: number, clientY: number) {
    if (!tip) return;
    const title = target.closest('a')?.getAttribute('data-tip-title') ?? target.getAttribute('aria-label') ?? '';
    const meta = target.closest('a')?.getAttribute('data-tip-meta') ?? '';
    tip.querySelector('.t')!.textContent = title;
    tip.querySelector('.m')!.textContent = meta;
    tip.classList.add('show');
    const pad = 14;
    const w = tip.offsetWidth;
    const h = tip.offsetHeight;
    let x = clientX + pad;
    let y = clientY + pad;
    if (x + w > innerWidth - 8) x = clientX - w - pad;
    if (y + h > innerHeight - 8) y = clientY - h - pad;
    tip.style.left = `${x}px`;
    tip.style.top = `${y}px`;
  }

  function hide() {
    tip?.classList.remove('show');
  }

  svg?.addEventListener('mousemove', (ev) => {
    const target = ev.target as Element;
    if (target.closest('.blip') || target.closest('.radar-legend a')) {
      show(target, (ev as MouseEvent).clientX, (ev as MouseEvent).clientY);
    } else {
      hide();
    }
  });
  svg?.addEventListener('mouseleave', hide);
  document.querySelector('.radar-legend')?.addEventListener('mousemove', (ev) => {
    const target = ev.target as Element;
    if (target.closest('a')) show(target, (ev as MouseEvent).clientX, (ev as MouseEvent).clientY);
  });
</script>
