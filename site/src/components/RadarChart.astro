---
import { u } from '../lib/url';
import { t, type Locale } from '../lib/i18n';

interface Props {
  events: any[];
  locale?: Locale;
}

const { events, locale = 'zh' } = Astro.props;

// 环带（内/外半径），按建议分区，最内环为 ADOPT。
const RINGS: Record<string, [number, number]> = {
  ADOPT: [30, 168],
  TRIAL: [172, 298],
  WATCH: [302, 418],
  IGNORE: [422, 468],
};
const RING_ORDER = ['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const;

// 象限为 [起始角, 结束角]（度）。SVG y 轴向下、角度自东向顺时针，
// 因此 [-90,0] 是右上楔形。
const QUADRANTS = [
  { id: 'models', labelKey: 'radar.quad.models', cats: ['foundation-model', 'research'], range: [-90, 0] },
  { id: 'agents', labelKey: 'radar.quad.agents', cats: ['agent-security', 'agent', 'ai-engineering'], range: [180, 270] },
  { id: 'infra', labelKey: 'radar.quad.infra', cats: ['open-source', 'infrastructure'], range: [90, 180] },
  { id: 'tools', labelKey: 'radar.quad.tools', cats: ['developer-tools', 'business'], range: [0, 90] },
] as const;

const CX = 500;
const CY = 500;
const REC_VAR: Record<string, string> = {
  ADOPT: 'var(--adopt)',
  TRIAL: 'var(--trial)',
  WATCH: 'var(--watch)',
  IGNORE: 'var(--ignore)',
};

// 每个 fingerprint 只保留一个光点，取最新事件。
const byFingerprint = new Map<string, any>();
for (const e of events) {
  const fp = e.event_fingerprint || e.event_id;
  const existing = byFingerprint.get(fp);
  if (!existing || String(e.published_date) > String(existing.published_date)) byFingerprint.set(fp, e);
}

type Blip = {
  no: number;
  x: number;
  y: number;
  rec: string;
  title: string;
  org: string;
  date: string;
  href: string;
};

// 光点在每个（象限 × 环）单元格内沿弧线均匀分布：按日期排序、
// 两条半径泳道交替。位置完全确定，避免随机散点的噪声与重叠。
const legend: { quad: (typeof QUADRANTS)[number]; blips: Blip[] }[] = [];
let counter = 0;
for (const quad of QUADRANTS) {
  const quadEvents = [...byFingerprint.values()]
    .filter((e) => quad.cats.includes(e.category))
    .sort((a, b) => String(a.published_date).localeCompare(String(b.published_date)));
  const cellSize = new Map<string, number>();
  for (const e of quadEvents) {
    const rec = RINGS[e.recommendation] ? e.recommendation : 'WATCH';
    cellSize.set(rec, (cellSize.get(rec) ?? 0) + 1);
  }
  const cellIdx = new Map<string, number>();
  const blips: Blip[] = [];
  for (const e of quadEvents) {
    counter += 1;
    const rec = RINGS[e.recommendation] ? e.recommendation : 'WATCH';
    const idx = cellIdx.get(rec) ?? 0;
    cellIdx.set(rec, idx + 1);
    const n = cellSize.get(rec)!;
    const [ri, ro] = RINGS[rec];
    const [qs, qe] = quad.range;
    const span = qe - qs;
    const pad = 14;
    const deg = n > 1 ? qs + pad + ((span - 2 * pad) * idx) / (n - 1) : qs + span / 2;
    const mid = (ri + ro) / 2;
    const laneGap = Math.min(16, (ro - ri) / 5);
    const radius = n > 2 ? mid + (idx % 2 === 0 ? -1 : 1) * laneGap : mid;
    const angle = (deg * Math.PI) / 180;
    blips.push({
      no: counter,
      x: CX + radius * Math.cos(angle),
      y: CY + radius * Math.sin(angle),
      rec,
      title: e.title,
      org: (e.organization ?? []).join(', '),
      date: e.published_date,
      href: u(`/events/${e.event_id}/`),
    });
  }
  legend.push({ quad, blips });
}

const ringMid = (r: keyof typeof RINGS) => (RINGS[r][0] + RINGS[r][1]) / 2;
const quadLabelPos = (range: [number, number]) => {
  const mid = ((range[0] + range[1]) / 2) * (Math.PI / 180);
  const r = 512;
  return { x: CX + r * Math.cos(mid), y: CY + r * Math.sin(mid) };
};
---

<div class="radar-lists">
  {legend.map(({ quad, blips }) => (
    <section class="quad-block">
      <h3 class="quad-head">{t(locale, quad.labelKey)}<span class="count">{blips.length}</span></h3>
      <ol class="quad-items">
        {blips.length === 0 && <li class="quad-empty">{t(locale, 'radar.empty')}</li>}
        {blips.map((b) => (
          <li>
            <a href={b.href} data-no={b.no} data-tip-title={b.title} data-tip-meta={`${b.org} · ${b.date} · ${b.rec}`}>
              <span class="no">{String(b.no).padStart(2, '0')}</span>
              <span class="rec-dot" style={`background: ${REC_VAR[b.rec] ?? REC_VAR.WATCH}`}></span>
              <span class="qi-title">{b.title}</span>
              <span class="qi-meta">{b.date}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<div class="radar-overview-head">
  <span class="kicker">{t(locale, 'radar.overview')}</span>
  <span class="legend">
    {RING_ORDER.map((r) => (
      <span class="legend-sw"><i style={`background: ${REC_VAR[r]}`}></i>{r}</span>
    ))}
    <span class="legend-note">{t(locale, 'radar.legendNote')}</span>
  </span>
</div>

<figure class="radar-figure">
  <svg class="radar-svg" viewBox="0 0 1000 1000" role="img" aria-label={t(locale, 'radar.aria')}>
    <circle class="adopt-disc" cx={CX} cy={CY} r={RINGS.ADOPT[1]} />
    {RING_ORDER.map((r) => (
      <circle class="ring-line" cx={CX} cy={CY} r={RINGS[r][1]} />
    ))}
    <circle class="ring-line" cx={CX} cy={CY} r={RINGS.ADOPT[0]} opacity="0.5" />
    <line class="axis-line" x1={CX} y1={CY - 476} x2={CX} y2={CY + 476} />
    <line class="axis-line" x1={CX - 476} y1={CY} x2={CX + 476} y2={CY} />

    {RING_ORDER.map((r) => (
      <text class="ring-label" x={CX} y={CY - ringMid(r)}>{r}</text>
    ))}

    {QUADRANTS.map((q) => {
      const p = quadLabelPos(q.range as unknown as [number, number]);
      return <text class="quad-label" x={p.x} y={p.y} text-anchor="middle">{t(locale, q.labelKey)}</text>;
    })}

    {legend.flatMap(({ blips }) =>
      blips.map((b) => (
        <a class="blip" href={b.href} data-no={b.no} aria-label={`${b.title}（${b.rec}）`} data-tip-title={b.title} data-tip-meta={`${b.org} · ${b.date} · ${b.rec}`}>
          <circle class="halo" cx={b.x} cy={b.y} r="17" stroke={REC_VAR[b.rec] ?? REC_VAR.WATCH} stroke-width="2" />
          <circle class="dot" cx={b.x} cy={b.y} r="11" fill={REC_VAR[b.rec] ?? REC_VAR.WATCH} />
          <text x={b.x} y={b.y + 0.5}>{b.no}</text>
        </a>
      ))
    )}
  </svg>
</figure>

<div class="radar-tip" id="radar-tip" aria-hidden="true">
  <div class="t"></div>
  <div class="m"></div>
</div>

<script>
  const tip = document.getElementById('radar-tip');

  function show(target: Element, clientX: number, clientY: number) {
    if (!tip) return;
    const anchor = target.closest('[data-tip-title]');
    if (!anchor) return;
    tip.querySelector('.t')!.textContent = anchor.getAttribute('data-tip-title') ?? '';
    tip.querySelector('.m')!.textContent = anchor.getAttribute('data-tip-meta') ?? '';
    tip.classList.add('show');
    const pad = 14;
    const w = tip.offsetWidth;
    const h = tip.offsetHeight;
    let x = clientX + pad;
    let y = clientY + pad;
    if (x + w > innerWidth - 8) x = clientX - w - pad;
    if (y + h > innerHeight - 8) y = clientY - h - pad;
    tip.style.left = `${x}px`;
    tip.style.top = `${y}px`;
  }

  function hide() {
    tip?.classList.remove('show');
  }

  document.addEventListener('mousemove', (ev) => {
    const target = (ev.target as Element).closest?.('[data-tip-title]');
    if (target) {
      show(target, (ev as MouseEvent).clientX, (ev as MouseEvent).clientY);
    } else {
      hide();
    }
  });
  document.addEventListener('mouseleave', hide);

  // 列表 ↔ 雷达图联动高亮：两侧元素通过 data-no 共享编号
  let current: string | null = null;
  function setHl(no: string, on: boolean) {
    for (const el of document.querySelectorAll(`[data-no="${CSS.escape(no)}"]`)) {
      el.classList.toggle('hl', on);
    }
  }
  document.addEventListener('mouseover', (ev) => {
    const target = (ev.target as Element).closest?.('[data-no]');
    const no = target?.getAttribute('data-no') ?? null;
    if (no === current) return;
    if (current) setHl(current, false);
    current = no;
    if (current) setHl(current, true);
  });
  document.addEventListener('mouseleave', () => {
    if (current) setHl(current, false);
    current = null;
  });
</script>
