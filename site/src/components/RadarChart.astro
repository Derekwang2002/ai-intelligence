---
import { u } from '../lib/url';
import { t, locTitle, type Locale } from '../lib/i18n';
import { QUADRANTS, quadLabel } from '../lib/quadrants';
import { shortLabel, labelWidth } from '../lib/shortLabel';

interface Props {
  events: any[];
  locale?: Locale;
}

const { events, locale = 'zh' } = Astro.props;

const RING_ORDER = ['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const;
const RING_IDX: Record<string, number> = { ADOPT: 0, TRIAL: 1, WATCH: 2, IGNORE: 3 };
// 泳道图象限色：站点无类别色相，这里给象限一组双主题可读的中饱和色
const QUAD_COLOR: Record<string, string> = {
  models: '#4f8ef7',
  agents: '#a78bfa',
  infra: '#34b08c',
  tools: '#e8a04c',
};

// 每个 fingerprint 只保留一个光点，取最新事件。
const byFingerprint = new Map<string, any>();
for (const e of events) {
  const fp = e.event_fingerprint || e.event_id;
  const existing = byFingerprint.get(fp);
  if (!existing || String(e.published_date) > String(existing.published_date)) byFingerprint.set(fp, e);
}
const unique = [...byFingerprint.values()];
// 新事件：数据窗口最后 2 天内发布（脉冲环）
const maxT = Math.max(...unique.map((e) => new Date(`${e.published_date}T00:00:00Z`).getTime()));
const isNew = (date: string) => maxT - new Date(`${date}T00:00:00Z`).getTime() <= 2 * 86400000;

type Blip = {
  no: number;
  rec: string;
  quad: string;
  date: string;
  title: string;
  label: string;
  lw: number;
  fresh: boolean;
  href: string;
};

const blips: Blip[] = [];
{
  let counter = 0;
  for (const e of unique) {
    const quad = QUADRANTS.find((q) => q.cats.includes(e.category));
    if (!quad) continue;
    counter += 1;
    const label = shortLabel(e);
    blips.push({
      no: counter,
      rec: RING_IDX[e.recommendation] !== undefined ? e.recommendation : 'WATCH',
      quad: quad.id,
      date: e.published_date,
      title: locTitle(e, locale),
      label,
      lw: labelWidth(label),
      fresh: isNew(e.published_date),
      href: u(`/events/${e.event_id}/`, locale),
    });
  }
}

// 悬停标签：默认在点上方，贴顶则放下方，左右越界则钳位
const tagPos = (b: { x: number; y: number; r: number; lw: number }, W: number) => {
  const above = b.y - b.r - 36 > 8;
  const ty = above ? b.y - b.r - 21 : b.y + b.r + 21;
  const tx = Math.min(Math.max(b.x, b.lw / 2 + 8), W - b.lw / 2 - 8);
  return { tx, ty };
};

// ---- 泳道布局：x=发布日期，y=建议等级，同道同日纵向错开 ----
const B_W = 1000;
const B_H = 560;
const B_LANE_H = 118;
const B_TOP = 24;
const B_PADL = 100;
const B_PADR = 30;
const bDates = [...new Set(blips.map((b) => b.date))].sort();
const bT0 = new Date(`${bDates[0]}T00:00:00Z`).getTime();
const bT1 = new Date(`${bDates[bDates.length - 1]}T00:00:00Z`).getTime();
const bX = (date: string) => {
  const tt = new Date(`${date}T00:00:00Z`).getTime();
  return bT1 === bT0 ? B_PADL + (B_W - B_PADL - B_PADR) / 2 : B_PADL + ((tt - bT0) / (bT1 - bT0)) * (B_W - B_PADL - B_PADR);
};
const bLaneY = (rec: string) => B_TOP + (RING_IDX[rec] ?? 2) * B_LANE_H + B_LANE_H / 2;
const bGroups = new Map<string, Blip[]>();
for (const b of blips) {
  const k = `${b.rec}|${b.date}`;
  if (!bGroups.has(k)) bGroups.set(k, []);
  bGroups.get(k)!.push(b);
}
const laneBlips: (Blip & { bx: number; by: number })[] = [];
for (const [, group] of bGroups) {
  group.forEach((b, i) => {
    const dy = (i - (group.length - 1) / 2) * 26;
    laneBlips.push({ ...b, bx: bX(b.date), by: bLaneY(b.rec) + dy });
  });
}
---

<div class="radar-overview-head">
  <span class="legend-note">{t(locale, 'radar.legendNote')}</span>
  <span class="radar-filters" id="radar-filters" hidden data-clear-label={t(locale, 'insights.filterClear')}></span>
</div>

<section class="card radar-overview">
  <figure class="radar-figure">
    <svg class="radar-svg" viewBox={`0 0 ${B_W} ${B_H}`} role="img" aria-label={t(locale, 'insights.radarTimeAria')}>
      {RING_ORDER.map((r) => (
        <>
          <line class="axis-line" x1={B_PADL} y1={B_TOP + RING_IDX[r] * B_LANE_H} x2={B_W - B_PADR} y2={B_TOP + RING_IDX[r] * B_LANE_H} />
          <text
            class="b-lane r-filter"
            x={B_PADL - 14}
            y={bLaneY(r)}
            data-ring={r}
            tabindex="0"
            role="button"
            aria-pressed="false"
            aria-label={`${r} · ${t(locale, 'insights.filterRingAria')}`}
          >{r}</text>
        </>
      ))}
      <line class="axis-line" x1={B_PADL} y1={B_TOP + 4 * B_LANE_H} x2={B_W - B_PADR} y2={B_TOP + 4 * B_LANE_H} />
      {bDates.map((d) => (
        <>
          <line class="b-grid" x1={bX(d)} y1={B_TOP} x2={bX(d)} y2={B_TOP + 4 * B_LANE_H} />
          <text class="b-tick" x={bX(d)} y={B_TOP + 4 * B_LANE_H + 26} text-anchor="middle">{d.slice(5)}</text>
        </>
      ))}
      {laneBlips.map((b) => {
        const tp = tagPos({ x: b.bx, y: b.by, r: 10, lw: b.lw }, B_W);
        return (
          <a class="blip" href={b.href} data-no={b.no} data-quad={b.quad} data-rec={b.rec} aria-label={`${b.title}（${b.rec}）`}>
            {b.fresh && <circle class="pulse" cx={b.bx} cy={b.by} r="14" stroke={QUAD_COLOR[b.quad]} stroke-width="2" />}
            <circle class="halo" cx={b.bx} cy={b.by} r="16" stroke={QUAD_COLOR[b.quad]} stroke-width="2" />
            <circle class="dot" cx={b.bx} cy={b.by} r="10" fill={QUAD_COLOR[b.quad]} />
            <g class="bl-tag">
              <rect x={tp.tx - b.lw / 2} y={tp.ty - 13} width={b.lw} height="26" rx="8" />
              <text x={tp.tx} y={tp.ty + 4.5} text-anchor="middle">{b.label}</text>
            </g>
          </a>
        );
      })}
    </svg>
  </figure>
  <p class="chart-note">
    {t(locale, 'insights.radarTimeNote')}
    {QUADRANTS.map((q, i) => (
      <>
        <span
          class="q-filter q-chip"
          data-quad={q.id}
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label={`${quadLabel(q.id, locale)} · ${t(locale, 'insights.filterQuadAria')}`}
        ><i class="chart-sw" style={`background: ${QUAD_COLOR[q.id]}`}></i>{quadLabel(q.id, locale)}</span>
        {i < QUADRANTS.length - 1 ? ' · ' : ''}
      </>
    ))}
  </p>
</section>

<script>
  // 象限 / 等级标签点击聚焦：两个维度可叠加，再次点击同一标签取消；
  // 非匹配光点调暗并禁用指针
  const filterBox = document.getElementById('radar-filters');
  let fq: string | null = null;
  let fr: string | null = null;
  let fqLabel = '';
  let frLabel = '';

  function applyFilters() {
    for (const blip of document.querySelectorAll<SVGElement>('a.blip')) {
      const ok = (!fq || blip.dataset.quad === fq) && (!fr || blip.dataset.rec === fr);
      blip.classList.toggle('dim', !ok);
    }
    for (const lab of document.querySelectorAll<SVGElement>('[data-quad].q-filter, [data-ring].r-filter')) {
      const isQuad = lab.hasAttribute('data-quad');
      const val = isQuad ? lab.getAttribute('data-quad') : lab.getAttribute('data-ring');
      const active = isQuad ? fq === val : fr === val;
      lab.classList.toggle('active', active);
      lab.classList.toggle('dim', (isQuad ? !!fq : !!fr) && !active);
      lab.setAttribute('aria-pressed', String(active));
    }
    renderChips();
  }

  function renderChips() {
    if (!filterBox) return;
    filterBox.innerHTML = '';
    const active = fq || fr;
    filterBox.hidden = !active;
    if (!active) return;
    const mk = (label: string, clear: () => void) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'fchip active';
      b.textContent = `${label} ×`;
      b.addEventListener('click', clear);
      filterBox.appendChild(b);
    };
    if (fq) mk(fqLabel, () => { fq = null; applyFilters(); });
    if (fr) mk(frLabel, () => { fr = null; applyFilters(); });
    const clear = document.createElement('button');
    clear.type = 'button';
    clear.className = 'fchip';
    clear.textContent = filterBox.dataset.clearLabel ?? 'Clear';
    clear.addEventListener('click', () => { fq = null; fr = null; applyFilters(); });
    filterBox.appendChild(clear);
  }

  function toggleFilter(el: Element) {
    if (el.hasAttribute('data-quad')) {
      const val = el.getAttribute('data-quad');
      fq = fq === val ? null : val;
      fqLabel = fq ? (el.textContent ?? '').trim() : '';
    } else if (el.hasAttribute('data-ring')) {
      const val = el.getAttribute('data-ring');
      fr = fr === val ? null : val;
      frLabel = fr ? (el.textContent ?? '').trim() : '';
    }
    applyFilters();
  }

  document.addEventListener('click', (ev) => {
    const lab = (ev.target as Element).closest?.('.q-filter, .r-filter');
    if (lab) toggleFilter(lab);
  });
  document.addEventListener('keydown', (ev) => {
    if ((ev as KeyboardEvent).key !== 'Enter' && (ev as KeyboardEvent).key !== ' ') return;
    const lab = (ev.target as Element).closest?.('.q-filter, .r-filter');
    if (lab) {
      ev.preventDefault();
      toggleFilter(lab);
    }
  });
</script>
