---
import { u } from '../lib/url';
import { t, locTitle, type Locale } from '../lib/i18n';
import { QUADRANTS, quadLabel } from '../lib/quadrants';
import { shortLabel, labelWidth } from '../lib/shortLabel';

interface Props {
  events: any[];
  locale?: Locale;
}

const { events, locale = 'zh' } = Astro.props;

const RING_ORDER = ['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const;
const RING_IDX: Record<string, number> = { ADOPT: 0, TRIAL: 1, WATCH: 2, IGNORE: 3 };
// 扇区底色与清单色标：站点无类别色相，这里给象限一组双主题可读的中饱和色
const QUAD_COLOR: Record<string, string> = {
  models: '#4f8ef7',
  agents: '#a78bfa',
  infra: '#34b08c',
  tools: '#e8a04c',
};

// 每个 fingerprint 只保留一个光点，取最新事件。
const byFingerprint = new Map<string, any>();
for (const e of events) {
  const fp = e.event_fingerprint || e.event_id;
  const existing = byFingerprint.get(fp);
  if (!existing || String(e.published_date) > String(existing.published_date)) byFingerprint.set(fp, e);
}
const unique = [...byFingerprint.values()];
// 新事件：数据窗口最后 2 天内发布（脉冲环）
const maxT = Math.max(...unique.map((e) => new Date(`${e.published_date}T00:00:00Z`).getTime()));
const isNew = (date: string) => maxT - new Date(`${date}T00:00:00Z`).getTime() <= 2 * 86400000;

type Blip = {
  no: number;
  rec: string;
  quad: string;
  date: string;
  title: string;
  label: string;
  lw: number;
  fresh: boolean;
  href: string;
};

// 编号顺序 = 清单顺序：象限 → 环 → 日期新到旧。纯函数于输入数据，重建布局不变。
const quadIdx = (id: string) => QUADRANTS.findIndex((q) => q.id === id);
const sorted = unique
  .map((e) => ({ e, quad: QUADRANTS.find((q) => q.cats.includes(e.category)) }))
  .filter((x) => x.quad)
  .sort(
    (a, b) =>
      quadIdx(a.quad!.id) - quadIdx(b.quad!.id) ||
      (RING_IDX[a.e.recommendation] ?? 2) - (RING_IDX[b.e.recommendation] ?? 2) ||
      String(b.e.published_date).localeCompare(String(a.e.published_date))
  );

const blips: Blip[] = sorted.map((x, i) => {
  const label = shortLabel(x.e);
  return {
    no: i + 1,
    rec: RING_IDX[x.e.recommendation] !== undefined ? x.e.recommendation : 'WATCH',
    quad: x.quad!.id,
    date: x.e.published_date,
    title: locTitle(x.e, locale),
    label,
    lw: labelWidth(label),
    fresh: isNew(x.e.published_date),
    href: u(`/events/${x.e.event_id}/`, locale),
  };
});

// ---- 几何：四扇区 × 四同心环（自内向外 ADOPT → TRIAL → WATCH → IGNORE）----
// 扇区边界落在水平 / 垂直轴上：象限 0 = 右上，顺时针排列
const W = 880;
const H = 740;
const CX = 440;
const CY = 370;
const R = 300;
const THICK = R / RING_ORDER.length;
const DOT_R = 10;
const sectorStart = (i: number) => -90 + i * 90;
const polar = (deg: number, r: number): [number, number] => [
  CX + r * Math.cos((deg * Math.PI) / 180),
  CY + r * Math.sin((deg * Math.PI) / 180),
];

// 同（象限 × 环）组内布点：小组单半径按角度均布；大组三个半径层循环 + 角度槽均布，
// 保证相邻光点中心距始终大于直径（确定性布局，重建不变）
const groups = new Map<string, Blip[]>();
for (const b of blips) {
  const k = `${b.quad}|${b.rec}`;
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(b);
}
type Placed = Blip & { x: number; y: number };
const placed: Placed[] = [];
for (const [k, group] of groups) {
  const [quad, rec] = k.split('|');
  const a0 = sectorStart(quadIdx(quad)) + 5; // 扇区内角边距
  const span = 90 - 10;
  const rIn = RING_IDX[rec] * THICK;
  const n = group.length;
  group.forEach((b, j) => {
    let ang: number;
    let r: number;
    if (n <= 4) {
      ang = a0 + ((j + 0.5) / n) * span;
      r = rIn + 0.5 * THICK;
    } else {
      const LEVELS = [0.16, 0.5, 0.84];
      const slots = Math.ceil(n / LEVELS.length);
      ang = a0 + ((Math.floor(j / LEVELS.length) + 0.5) / slots) * span;
      r = rIn + LEVELS[j % LEVELS.length] * THICK;
    }
    r = Math.max(r, DOT_R + 3); // 内环小组不压圆心
    const [x, y] = polar(ang, r);
    placed.push({ ...b, x, y });
  });
}

// 悬停标签：默认在点上方，贴顶则放下方，左右越界则钳位
const tagPos = (b: { x: number; y: number; lw: number }) => {
  const above = b.y - DOT_R - 36 > 8;
  const ty = above ? b.y - DOT_R - 21 : b.y + DOT_R + 21;
  const tx = Math.min(Math.max(b.x, b.lw / 2 + 8), W - b.lw / 2 - 8);
  return { tx, ty };
};

// 扇区淡色楔形底
const wedge = (i: number) => {
  const [x0, y0] = polar(sectorStart(i), R);
  const [x1, y1] = polar(sectorStart(i) + 90, R);
  return `M ${CX} ${CY} L ${x0.toFixed(1)} ${y0.toFixed(1)} A ${R} ${R} 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)} Z`;
};
---

<div class="radar-overview-head">
  <span class="legend-note">{t(locale, 'radar.legendNote')}</span>
  <span class="radar-filters" id="radar-filters" hidden data-clear-label={t(locale, 'insights.filterClear')}></span>
</div>

<div class="radar-layout">
  <section class="card radar-overview">
    <figure class="radar-figure">
      <svg class="radar-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t(locale, 'insights.radarTimeAria')}>
        {QUADRANTS.map((q, i) => <path class="wedge" d={wedge(i)} fill={QUAD_COLOR[q.id]} />)}
        {RING_ORDER.map((_, i) => <circle class="axis-line" cx={CX} cy={CY} r={(i + 1) * THICK} fill="none" />)}
        <line class="axis-line" x1={CX - R} y1={CY} x2={CX + R} y2={CY} />
        <line class="axis-line" x1={CX} y1={CY - R} x2={CX} y2={CY + R} />
        {RING_ORDER.map((r, i) => (
          <text
            class="b-ring r-filter"
            x={CX + 9}
            y={CY + (i + 0.5) * THICK}
            data-ring={r}
            tabindex="0"
            role="button"
            aria-pressed="false"
            aria-label={`${r} · ${t(locale, 'insights.filterRingAria')}`}
          >{r}</text>
        ))}
        {QUADRANTS.map((q, i) => {
          const [qx, qy] = polar(sectorStart(i) + 45, R + 30);
          return (
            <text
              class="q-label q-filter"
              x={qx}
              y={qy}
              text-anchor={i <= 1 ? 'start' : 'end'}
              data-quad={q.id}
              tabindex="0"
              role="button"
              aria-pressed="false"
              aria-label={`${quadLabel(q.id, locale)} · ${t(locale, 'insights.filterQuadAria')}`}
            >{quadLabel(q.id, locale)}</text>
          );
        })}
        {placed.map((b) => {
          const tp = tagPos(b);
          return (
            <a
              class="blip"
              href={b.href}
              data-no={b.no}
              data-quad={b.quad}
              data-rec={b.rec}
              style={`color: var(--${b.rec.toLowerCase()})`}
              aria-label={`${b.title}（${b.rec}）`}
            >
              {b.fresh && <circle class="pulse" cx={b.x} cy={b.y} r="15" stroke="currentColor" stroke-width="2" />}
              <circle class="halo" cx={b.x} cy={b.y} r="16" stroke="currentColor" stroke-width="2" />
              <circle class="dot" cx={b.x} cy={b.y} r={DOT_R} fill="currentColor" />
              <text class="bl-no" x={b.x} y={b.y + 3.4} text-anchor="middle">{b.no}</text>
              <g class="bl-tag">
                <rect x={tp.tx - b.lw / 2} y={tp.ty - 13} width={b.lw} height="26" rx="8" />
                <text x={tp.tx} y={tp.ty + 4.5} text-anchor="middle">{b.label}</text>
              </g>
            </a>
          );
        })}
      </svg>
    </figure>
    {placed.some((b) => b.fresh) && <p class="chart-note">{t(locale, 'insights.radarPulseNote')}</p>}
  </section>

  <aside class="radar-list" aria-label={t(locale, 'insights.radarTimeAria')}>
    {QUADRANTS.map((q) => {
      const items = placed.filter((b) => b.quad === q.id);
      if (items.length === 0) return null;
      return (
        <div class="rl-group">
          <h4 class="rl-head">
            <i class="chart-sw" style={`background: ${QUAD_COLOR[q.id]}`}></i>
            {quadLabel(q.id, locale)}
            <span class="rl-count">{items.length}</span>
          </h4>
          <div class="rl-items">
            {items.map((b) => (
              <a class="rl-item" href={b.href} data-no={b.no} data-quad={b.quad} data-rec={b.rec}>
                <span class="rl-no" style={`background: var(--${b.rec.toLowerCase()})`}>{b.no}</span>
                <span class="rl-label">{b.label}</span>
                <span class="rl-date">{String(b.date).slice(5)}</span>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </aside>
</div>

<script>
  // 象限 / 等级标签点击聚焦：两个维度可叠加，再次点击同一标签取消；
  // 非匹配光点与清单条目调暗并禁用指针
  const filterBox = document.getElementById('radar-filters');
  let fq: string | null = null;
  let fr: string | null = null;
  let fqLabel = '';
  let frLabel = '';

  function applyFilters() {
    for (const el of document.querySelectorAll<SVGElement>('a.blip, .rl-item')) {
      const ok = (!fq || (el as HTMLElement).dataset.quad === fq) && (!fr || (el as HTMLElement).dataset.rec === fr);
      el.classList.toggle('dim', !ok);
    }
    for (const lab of document.querySelectorAll<SVGElement>('.q-filter[data-quad], .r-filter[data-ring]')) {
      const isQuad = lab.hasAttribute('data-quad');
      const val = isQuad ? lab.getAttribute('data-quad') : lab.getAttribute('data-ring');
      const active = isQuad ? fq === val : fr === val;
      lab.classList.toggle('active', active);
      lab.classList.toggle('dim', (isQuad ? !!fq : !!fr) && !active);
      lab.setAttribute('aria-pressed', String(active));
    }
    renderChips();
  }

  function renderChips() {
    if (!filterBox) return;
    filterBox.innerHTML = '';
    const active = fq || fr;
    filterBox.hidden = !active;
    if (!active) return;
    const mk = (label: string, clear: () => void) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'fchip active';
      b.textContent = `${label} ×`;
      b.addEventListener('click', clear);
      filterBox.appendChild(b);
    };
    if (fq) mk(fqLabel, () => { fq = null; applyFilters(); });
    if (fr) mk(frLabel, () => { fr = null; applyFilters(); });
    const clear = document.createElement('button');
    clear.type = 'button';
    clear.className = 'fchip';
    clear.textContent = filterBox.dataset.clearLabel ?? 'Clear';
    clear.addEventListener('click', () => { fq = null; fr = null; applyFilters(); });
    filterBox.appendChild(clear);
  }

  function toggleFilter(el: Element) {
    if (el.hasAttribute('data-quad')) {
      const val = el.getAttribute('data-quad');
      fq = fq === val ? null : val;
      fqLabel = fq ? (el.textContent ?? '').trim() : '';
    } else if (el.hasAttribute('data-ring')) {
      const val = el.getAttribute('data-ring');
      fr = fr === val ? null : val;
      frLabel = fr ? (el.textContent ?? '').trim() : '';
    }
    applyFilters();
  }

  // 清单条目 hover 联动光点高亮
  function syncHl(no: string | undefined, on: boolean) {
    if (!no) return;
    document.querySelector(`a.blip[data-no="${no}"]`)?.classList.toggle('hl', on);
  }
  document.querySelectorAll<HTMLElement>('.rl-item').forEach((it) => {
    it.addEventListener('mouseenter', () => syncHl(it.dataset.no, true));
    it.addEventListener('mouseleave', () => syncHl(it.dataset.no, false));
  });

  document.addEventListener('click', (ev) => {
    const lab = (ev.target as Element).closest?.('.q-filter, .r-filter');
    if (lab) toggleFilter(lab);
  });
  document.addEventListener('keydown', (ev) => {
    if ((ev as KeyboardEvent).key !== 'Enter' && (ev as KeyboardEvent).key !== ' ') return;
    const lab = (ev.target as Element).closest?.('.q-filter, .r-filter');
    if (lab) {
      ev.preventDefault();
      toggleFilter(lab);
    }
  });
</script>
