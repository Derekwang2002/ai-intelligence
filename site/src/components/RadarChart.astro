---
import { u } from '../lib/url';
import { t, locTitle, type Locale } from '../lib/i18n';

interface Props {
  events: any[];
  locale?: Locale;
}

const { events, locale = 'zh' } = Astro.props;

// 环带（内/外半径），按建议分区，最内环为 ADOPT。
const RINGS: Record<string, [number, number]> = {
  ADOPT: [30, 168],
  TRIAL: [172, 298],
  WATCH: [302, 418],
  IGNORE: [422, 468],
};
const RING_ORDER = ['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const;

// 象限为 [起始角, 结束角]（度）。SVG y 轴向下、角度自东向顺时针，
// 因此 [-90,0] 是右上楔形。
const QUADRANTS = [
  { id: 'models', labelKey: 'radar.quad.models', cats: ['foundation-model', 'research'], range: [-90, 0] },
  { id: 'agents', labelKey: 'radar.quad.agents', cats: ['agent-security', 'agent', 'ai-engineering'], range: [180, 270] },
  { id: 'infra', labelKey: 'radar.quad.infra', cats: ['open-source', 'infrastructure'], range: [90, 180] },
  { id: 'tools', labelKey: 'radar.quad.tools', cats: ['developer-tools', 'business'], range: [0, 90] },
] as const;

const CX = 500;
const CY = 500;
const REC_VAR: Record<string, string> = {
  ADOPT: 'var(--adopt)',
  TRIAL: 'var(--trial)',
  WATCH: 'var(--watch)',
  IGNORE: 'var(--ignore)',
};

// 每个 fingerprint 只保留一个光点，取最新事件。
const byFingerprint = new Map<string, any>();
for (const e of events) {
  const fp = e.event_fingerprint || e.event_id;
  const existing = byFingerprint.get(fp);
  if (!existing || String(e.published_date) > String(existing.published_date)) byFingerprint.set(fp, e);
}

type Blip = {
  no: number;
  x: number;
  y: number;
  rec: string;
  quad: string;
  title: string;
  date: string;
  href: string;
};

// 光点在每个（象限 × 环）单元格内沿弧线均匀分布：按日期排序、
// 两条半径泳道交替。位置完全确定，避免随机散点的噪声与重叠。
const legend: { quad: (typeof QUADRANTS)[number]; blips: Blip[] }[] = [];
let counter = 0;
for (const quad of QUADRANTS) {
  const quadEvents = [...byFingerprint.values()]
    .filter((e) => quad.cats.includes(e.category))
    .sort((a, b) => String(a.published_date).localeCompare(String(b.published_date)));
  const cellSize = new Map<string, number>();
  for (const e of quadEvents) {
    const rec = RINGS[e.recommendation] ? e.recommendation : 'WATCH';
    cellSize.set(rec, (cellSize.get(rec) ?? 0) + 1);
  }
  const cellIdx = new Map<string, number>();
  const blips: Blip[] = [];
  for (const e of quadEvents) {
    counter += 1;
    const rec = RINGS[e.recommendation] ? e.recommendation : 'WATCH';
    const idx = cellIdx.get(rec) ?? 0;
    cellIdx.set(rec, idx + 1);
    const n = cellSize.get(rec)!;
    const [ri, ro] = RINGS[rec];
    const [qs, qe] = quad.range;
    const span = qe - qs;
    const pad = 14;
    const deg = n > 1 ? qs + pad + ((span - 2 * pad) * idx) / (n - 1) : qs + span / 2;
    const mid = (ri + ro) / 2;
    const laneGap = Math.min(16, (ro - ri) / 5);
    const radius = n > 2 ? mid + (idx % 2 === 0 ? -1 : 1) * laneGap : mid;
    const angle = (deg * Math.PI) / 180;
    blips.push({
      no: counter,
      x: CX + radius * Math.cos(angle),
      y: CY + radius * Math.sin(angle),
      rec,
      quad: quad.id,
      title: locTitle(e, locale),
      date: e.published_date,
      href: u(`/events/${e.event_id}/`, locale),
    });
  }
  legend.push({ quad, blips });
}

const ringMid = (r: keyof typeof RINGS) => (RINGS[r][0] + RINGS[r][1]) / 2;
const quadLabelPos = (range: readonly [number, number]) => {
  const mid = ((range[0] + range[1]) / 2) * (Math.PI / 180);
  const r = 512;
  return { x: CX + r * Math.cos(mid), y: CY + r * Math.sin(mid) };
};
---

<div class="radar-overview-head">
  <span class="legend">
    {RING_ORDER.map((r) => (
      <span class="legend-sw"><i style={`background: ${REC_VAR[r]}`}></i>{r}</span>
    ))}
    <span class="legend-note">{t(locale, 'radar.legendNote')}</span>
  </span>
  <span class="radar-filters" id="radar-filters" hidden data-clear-label={t(locale, 'insights.filterClear')}></span>
</div>

<div class="radar-split">
  <div class="radar-side">
    <section class="card radar-overview">
      <figure class="radar-figure">
        <svg class="radar-svg" viewBox="0 0 1000 1000" role="img" aria-label={t(locale, 'radar.aria')}>
        <circle class="adopt-disc" cx={CX} cy={CY} r={RINGS.ADOPT[1]} />
        {RING_ORDER.map((r) => (
          <circle class="ring-line" cx={CX} cy={CY} r={RINGS[r][1]} />
        ))}
        <circle class="ring-line" cx={CX} cy={CY} r={RINGS.ADOPT[0]} opacity="0.5" />
        <line class="axis-line" x1={CX} y1={CY - 476} x2={CX} y2={CY + 476} />
        <line class="axis-line" x1={CX - 476} y1={CY} x2={CX + 476} y2={CY} />

        {RING_ORDER.map((r) => (
          <text
            class="ring-label r-filter"
            x={CX}
            y={CY - ringMid(r)}
            data-ring={r}
            tabindex="0"
            role="button"
            aria-pressed="false"
            aria-label={`${r} · ${t(locale, 'insights.filterRingAria')}`}
          >{r}</text>
        ))}

        {QUADRANTS.map((q) => {
          const p = quadLabelPos(q.range);
          return (
            <text
              class="quad-label q-filter"
              x={p.x}
              y={p.y}
              text-anchor="middle"
              data-quad={q.id}
              tabindex="0"
              role="button"
              aria-pressed="false"
              aria-label={`${t(locale, q.labelKey)} · ${t(locale, 'insights.filterQuadAria')}`}
            >{t(locale, q.labelKey)}</text>
          );
        })}

        {legend.flatMap(({ blips }) =>
          blips.map((b) => (
            <a class="blip" href={b.href} data-no={b.no} data-quad={b.quad} data-rec={b.rec} aria-label={`${b.title}（${b.rec}）`}>
              <circle class="halo" cx={b.x} cy={b.y} r="17" stroke={REC_VAR[b.rec] ?? REC_VAR.WATCH} stroke-width="2" />
              <circle class="dot" cx={b.x} cy={b.y} r="11" fill={REC_VAR[b.rec] ?? REC_VAR.WATCH} />
              <text x={b.x} y={b.y + 0.5}>{b.no}</text>
            </a>
          ))
        )}
      </svg>
      </figure>
    </section>
  </div>

  <div class="radar-lists">
    {legend.map(({ quad, blips }) => (
      <section class="quad-block" data-quad={quad.id}>
        <h3 class="quad-head">{t(locale, quad.labelKey)}<span class="count">{blips.length}</span></h3>
        <ol class="quad-items">
          {blips.length === 0 && <li class="quad-empty">{t(locale, 'radar.empty')}</li>}
          {blips.map((b) => (
            <li id={`blip-${b.no}`} data-rec={b.rec}>
              <a href={b.href} data-no={b.no}>
                <span class="no">{String(b.no).padStart(2, '0')}</span>
                <span class="rec-dot" style={`background: ${REC_VAR[b.rec] ?? REC_VAR.WATCH}`}></span>
                <span class="qi-title">{b.title}</span>
                <span class="qi-meta">{b.date}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</div>

<script>
  // 列表 ↔ 雷达图联动高亮：两侧元素通过 data-no 共享编号
  let current: string | null = null;
  function setHl(no: string, on: boolean) {
    for (const el of document.querySelectorAll(`[data-no="${CSS.escape(no)}"]`)) {
      el.classList.toggle('hl', on);
    }
  }
  document.addEventListener('mouseover', (ev) => {
    const target = (ev.target as Element).closest?.('[data-no]');
    const no = target?.getAttribute('data-no') ?? null;
    if (no === current) return;
    if (current) setHl(current, false);
    current = no;
    if (current) setHl(current, true);
  });
  document.addEventListener('mouseleave', () => {
    if (current) setHl(current, false);
    current = null;
  });

  // 点击光点：不跳转，平滑滚动到对应清单行并闪烁定位（修飾键/中键保持原有打开行为）
  document.addEventListener('click', (ev) => {
    const blip = (ev.target as Element).closest?.('a.blip');
    if (!blip) return;
    const mev = ev as MouseEvent;
    if (mev.button !== 0 || mev.metaKey || mev.ctrlKey || mev.shiftKey || mev.altKey) return;
    ev.preventDefault();
    const no = blip.getAttribute('data-no');
    const row = no && document.getElementById(`blip-${no}`);
    if (!row) return;
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    row.classList.remove('flash');
    void row.offsetWidth; // 重新触发动画
    row.classList.add('flash');
  });

  // 象限 / 环标签点击筛选：两个维度可叠加，再次点击同一标签取消。
  // 清单行按维度隐藏，光点调暗并禁用指针，避免“点了跳到一个看不见的行”。
  const filterBox = document.getElementById('radar-filters');
  let fq: string | null = null;
  let fr: string | null = null;
  let fqLabel = '';
  let frLabel = '';

  function applyFilters() {
    for (const block of document.querySelectorAll<HTMLElement>('.quad-block')) {
      const quadOk = !fq || block.dataset.quad === fq;
      let visibleRows = 0;
      for (const li of block.querySelectorAll<HTMLElement>('li[data-rec]')) {
        const show = quadOk && (!fr || li.dataset.rec === fr);
        li.classList.toggle('hide', !show);
        if (show) visibleRows += 1;
      }
      block.classList.toggle('hide', !quadOk || visibleRows === 0);
    }
    for (const blip of document.querySelectorAll<SVGElement>('a.blip')) {
      const ok = (!fq || blip.dataset.quad === fq) && (!fr || blip.dataset.rec === fr);
      blip.classList.toggle('dim', !ok);
    }
    for (const lab of document.querySelectorAll<SVGElement>('[data-quad].q-filter, [data-ring].r-filter')) {
      const isQuad = lab.hasAttribute('data-quad');
      const val = isQuad ? lab.getAttribute('data-quad') : lab.getAttribute('data-ring');
      const active = isQuad ? fq === val : fr === val;
      lab.classList.toggle('active', active);
      lab.classList.toggle('dim', (isQuad ? !!fq : !!fr) && !active);
      lab.setAttribute('aria-pressed', String(active));
    }
    renderChips();
  }

  function renderChips() {
    if (!filterBox) return;
    filterBox.innerHTML = '';
    const active = fq || fr;
    filterBox.hidden = !active;
    if (!active) return;
    const mk = (label: string, clear: () => void) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'fchip active';
      b.textContent = `${label} ×`;
      b.addEventListener('click', clear);
      filterBox.appendChild(b);
    };
    if (fq) mk(fqLabel, () => { fq = null; applyFilters(); });
    if (fr) mk(frLabel, () => { fr = null; applyFilters(); });
    const clear = document.createElement('button');
    clear.type = 'button';
    clear.className = 'fchip';
    clear.textContent = filterBox.dataset.clearLabel ?? 'Clear';
    clear.addEventListener('click', () => { fq = null; fr = null; applyFilters(); });
    filterBox.appendChild(clear);
  }

  function toggleFilter(el: Element) {
    if (el.hasAttribute('data-quad')) {
      const val = el.getAttribute('data-quad');
      fq = fq === val ? null : val;
      fqLabel = fq ? (el.textContent ?? '') : '';
    } else if (el.hasAttribute('data-ring')) {
      const val = el.getAttribute('data-ring');
      fr = fr === val ? null : val;
      frLabel = fr ? (el.textContent ?? '') : '';
    }
    applyFilters();
  }

  document.addEventListener('click', (ev) => {
    const lab = (ev.target as Element).closest?.('.q-filter, .r-filter');
    if (lab) toggleFilter(lab);
  });
  document.addEventListener('keydown', (ev) => {
    if ((ev as KeyboardEvent).key !== 'Enter' && (ev as KeyboardEvent).key !== ' ') return;
    const lab = (ev.target as Element).closest?.('.q-filter, .r-filter');
    if (lab) {
      ev.preventDefault();
      toggleFilter(lab);
    }
  });
</script>
