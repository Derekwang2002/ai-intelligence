---
import { t, type Locale, type UiKey } from '../lib/i18n';

interface Props {
  rec: string;
  locale?: Locale;
}
const { rec, locale = 'zh' } = Astro.props;
const cls =
  { ADOPT: 'badge-adopt', TRIAL: 'badge-trial', WATCH: 'badge-watch', IGNORE: 'badge-ignore' }[rec] ?? 'badge-ignore';
---

<span class={`badge ${cls}`} title={t(locale, `rec.${rec}` as UiKey)}>{rec}</span>
