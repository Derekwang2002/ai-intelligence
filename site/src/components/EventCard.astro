---
import RecBadge from './RecBadge.astro';
import { u } from '../lib/url';
import { t, loc, locTitle, catLabel, type Locale } from '../lib/i18n';

interface Props {
  event: any;
  compact?: boolean;
  locale?: Locale;
}

const { event, compact = false, locale = 'zh' } = Astro.props;
const href = u(`/events/${event.event_id}/`, locale);
const title = locTitle(event, locale);
const summary = loc(event, 'summary', locale);

// 组织名与其同名 hashtag（如 org "Qwen" + tag "qwen"）只保留组织标签；
// 底部空间有限，组织与标签各取前 2 个，其余合并为 +N（悬停可见完整清单）。
const orgs = event.organization ?? [];
const orgLower = new Set(orgs.map((o: string) => o.toLowerCase()));
const allTags = (event.tags ?? []).filter((tag: string) => !orgLower.has(tag.toLowerCase()));
const shownOrgs = orgs.slice(0, 2);
const shownTags = allTags.slice(0, 2);
const hiddenItems = [...orgs.slice(2), ...allTags.slice(2)];
---

<a class="event-card" href={href} data-cat={event.category} data-rec={event.recommendation} data-org={(event.organization ?? []).join('|')} data-tags={(event.tags ?? []).join('|')} data-q={`${event.title} ${event.title_zh ?? ''} ${event.summary ?? ''} ${event.summary_zh ?? ''} ${(event.organization ?? []).join(' ')} ${(event.tags ?? []).join(' ')}`.toLowerCase()}>
  <div class="top">
    <span class="date">{event.published_date}</span>
    <span class="cat-chip">{catLabel(event.category, locale)}</span>
    <RecBadge rec={event.recommendation} />
  </div>
  <h3>{title}</h3>
  {!compact && summary && <p class="summary">{summary}</p>}
  <div class="bottom">
    {shownOrgs.map((org: string) => <span class="tag">{org}</span>)}
    {shownTags.map((tag: string) => <span class="tag">{tag}</span>)}
    {hiddenItems.length > 0 && <span class="tag tag-more" data-more={hiddenItems.join('|')} title={hiddenItems.join(', ')}>+{hiddenItems.length}</span>}
    <span class="score-meter" title={t(locale, 'scores.tripleTitle')}>
      {[
        { label: t(locale, 'scores.impact'), v: event.technical_impact ?? 0 },
        { label: t(locale, 'scores.engineering'), v: event.engineering_value ?? 0 },
        { label: t(locale, 'scores.adoption'), v: event.adoption_signal ?? 0 },
      ].map((s: { label: string; v: number }) => {
        const val = Math.max(0, Math.min(5, s.v));
        return (
          <span class="sc">
            <span class="sc-label">{s.label}</span>
            <span class="sc-bar">{[1, 2, 3, 4, 5].map((n) => <i class={n <= val ? 'on' : ''} />)}</span>
            <span class="sc-num">{s.v}</span>
          </span>
        );
      })}
    </span>
  </div>
</a>
