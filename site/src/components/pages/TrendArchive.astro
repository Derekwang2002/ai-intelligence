---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import { t, loc, type Locale } from '../../lib/i18n';

interface Props {
  snapshot: any;
  locale?: Locale;
}

const { snapshot, locale = 'zh' } = Astro.props;
---

<Base title={`${t(locale, 'trends.archiveTitle')} ${snapshot.date}`} locale={locale}>
  <div class="article-head">
    <div class="back-row">
      <a class="btn-ghost btn-sm" href={u('/trends/', locale)}>{t(locale, 'trends.back')}</a>
      <span style="color: var(--text-faint); font-size: 12.5px;">{t(locale, 'trends.archiveCrumb')}</span>
    </div>
    <h1>{t(locale, 'trends.archiveTitle')} · {snapshot.date}</h1>
  </div>
  <div class="article-body">
    <div class="prose" set:html={loc(snapshot, 'html', locale)} />
  </div>
</Base>
