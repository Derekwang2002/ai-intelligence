---
import Base from '../../layouts/Base.astro';
import RadarChart from '../RadarChart.astro';
import { t, type Locale } from '../../lib/i18n';
import events from '../../data/generated/events.json';
import aggregates from '../../data/generated/aggregates.json';

interface Props {
  locale?: Locale;
}
const { locale = 'zh' } = Astro.props;
---

<Base title={t(locale, 'radar.title')} description={t(locale, 'radar.description')} locale={locale}>
  <div class="page-head">
    <div class="head-row">
      <h1>{t(locale, 'radar.title')}</h1>
      <span class="en">{t(locale, 'radar.en')}</span>
    </div>
    <p class="desc">
      {t(locale, 'radar.descPre')}<b>ADOPT</b>{t(locale, 'radar.descMid1')}<b>IGNORE</b>{t(locale, 'radar.descMid2')}
      <code>{aggregates.totals.events}</code>{t(locale, 'radar.descEvents')}
      <code>{new Set(events.map((e: any) => e.event_fingerprint)).size}</code>{t(locale, 'radar.descUnique')}
    </p>
  </div>
  <RadarChart events={events} locale={locale} />
</Base>
