---
import Base from '../../layouts/Base.astro';
import ReaderActions from '../ReaderActions.astro';
import {intel,pick,words} from '../../lib/intelligence';
import {u,fmtDate} from '../../lib/url';
const {locale='zh'}=Astro.props;
---
<Base title={words(locale,'项目档案','Projects')} locale={locale}>
<header class="editorial-head"><div class="eyebrow">MATRIX / PROJECTS</div><h1>{words(locale,'项目档案','Projects')}</h1><p class="lead">{words(locale,'模型、工具与协议的持续档案。看当前状态，也看一路如何走来。','Living records of models, tools and protocols. See their current state and how they got here.')}</p></header>
<div class="project-grid">{intel.projects.map((p:any)=><article class="project-tile"><div class="eyebrow">{words(locale,({'developer-tool':'开发工具',framework:'框架','model-family':'模型家族',protocol:'协议'}[p.type]||p.type),p.type.replaceAll('-',' '))}</div><h2><a href={u(`/projects/${p.id}/`,locale)}>{pick(p,'name',locale)}</a></h2><p>{p.event_ids.length} {words(locale,'条相关事件','related events')} · {fmtDate(p.as_of)}</p><ReaderActions locale={locale} follow={`project:${p.id}`}/><a class="text-link" href={u(`/projects/${p.id}/`,locale)}>{words(locale,'查看档案','Open record')} →</a></article>)}</div>
</Base>
