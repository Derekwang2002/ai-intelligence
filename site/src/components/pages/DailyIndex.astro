---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import { t, loc, type Locale } from '../../lib/i18n';
import daily from '../../data/generated/daily.json';

interface Props {
  locale?: Locale;
}
const { locale = 'zh' } = Astro.props;

// 日期字符串按 UTC 解析，避免本地时区把星期几算偏一天。
function weekday(date: string): string {
  const d = new Date(`${date}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return '';
  return new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
    weekday: 'short',
    timeZone: 'UTC',
  }).format(d);
}

const monthLabel = (mk: string) => {
  const [y, mo] = mk.split('-').map(Number);
  return new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long' }).format(new Date(y, mo - 1, 1));
};

// 日历总览 + 按月折叠：日历给全局分布（有报告的日期可点击直达），
// 列表按月分组，只有最新一个月默认展开——日报逐日累积也不会淹没首屏
const reportDates = new Set(daily.map((d: any) => String(d.date)));
const monthKeys = [...new Set(daily.map((d: any) => String(d.date).slice(0, 7)))].sort().reverse();
const WEEKDAYS = locale === 'zh'
  ? ['一', '二', '三', '四', '五', '六', '日']
  : ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const calMonths = monthKeys.map((mk) => {
  const [y, mo] = mk.split('-').map(Number);
  const offset = (new Date(y, mo - 1, 1).getDay() + 6) % 7; // 周一开头
  const days = new Date(y, mo, 0).getDate();
  const cells: ({ day: number; date: string; has: boolean } | null)[] = Array(offset).fill(null);
  for (let d = 1; d <= days; d++) {
    const date = `${mk}-${String(d).padStart(2, '0')}`;
    cells.push({ day: d, date, has: reportDates.has(date) });
  }
  return { label: monthLabel(mk), cells };
});
const byMonth = monthKeys.map((mk) => [mk, daily.filter((d: any) => String(d.date).startsWith(mk))] as const);
---

<Base title={t(locale, 'daily.title')} description={t(locale, 'daily.description')} locale={locale}>
  <div class="page-head">
    <div class="head-row">
      <h1>{t(locale, 'daily.title')}</h1>
      <span class="en">{t(locale, 'daily.en')}</span>
    </div>
    <p class="desc">{t(locale, 'daily.desc')}</p>
  </div>

  <div class="card dl-cal">
    <div class="ev-cal-head">
      {t(locale, 'daily.calendar')}
      <span class="legend-note">{t(locale, 'daily.calendarNote')}</span>
    </div>
    <div class="cal-wrap">
      {calMonths.map((m) => (
        <div class="ev-cal-month">
          <div class="cal-head">{m.label}</div>
          <div class="cal-grid">
            {WEEKDAYS.map((w) => <span class="cal-wd">{w}</span>)}
            {m.cells.map((c) =>
              c === null ? (
                <span class="cal-day"></span>
              ) : c.has ? (
                <a class="cal-day" href={u(`/daily/${c.date}/`, locale)} aria-label={c.date}>{c.day}</a>
              ) : (
                <span class="cal-day">{c.day}</span>
              )
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="daily-list">
    {byMonth.map(([mk, list], mi) => (
      <details class="dl-month" open={mi === 0}>
        <summary class="dl-month-head">
          <h2>{monthLabel(mk)}</h2>
          <span class="n">{list.length} {t(locale, 'daily.reportUnit')}</span>
        </summary>
        <div class="dl-rows">
        {list.map((d: any) => {
          const items = (loc(d, 'highlights', locale) as unknown as any[]) || [];
          const shown = items.slice(0, 3);
          const extra = items.length - shown.length;
          return (
            <a class="daily-row" href={u(`/daily/${d.date}/`, locale)}>
              <span class="d-side">
                <span class="d-date">{d.date}</span>
                <span class="d-sub">
                  {weekday(d.date)}{items.length > 0 && ` · ${t(locale, 'daily.itemCount').replace('{n}', String(items.length))}`}
                </span>
              </span>
              {shown.length > 0 ? (
                <span class="d-highlights">
                  {shown.map((h: any) => (
                    <span class="d-hl">
                      <span class="d-hl-head">
                        {h.kind && (
                          <span class={`hl-chip hl-${h.kind}`}>
                            {t(locale, h.kind === 'new' ? 'daily.kindNew' : 'daily.kindUpdate')}
                          </span>
                        )}
                        <span class="d-hl-title">{h.title}</span>
                      </span>
                      {h.body && <span class="d-hl-body">{h.body}</span>}
                    </span>
                  ))}
                  {extra > 0 && <span class="d-more">{t(locale, 'daily.moreItems').replace('{n}', String(extra))}</span>}
                </span>
              ) : (
                <p class="d-excerpt">{loc(d, 'excerpt', locale)}</p>
              )}
              <span class="d-arrow">→</span>
            </a>
          );
        })}
        </div>
      </details>
    ))}
  </div>
</Base>

<script>
  import { attachFoldAnim } from '../../lib/detailsFold';
  // 月份分组的折叠/展开走全站统一的非线性动画（AGENTS.md §19）
  attachFoldAnim('details.dl-month', '.dl-rows');
</script>
