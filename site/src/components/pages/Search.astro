---
import Base from '../../layouts/Base.astro';
import {u} from '../../lib/url';
import {words} from '../../lib/intelligence';
const {locale='zh'}=Astro.props;
---
<Base title={words(locale,'搜索','Search')} locale={locale}>
<header class="editorial-head"><div class="eyebrow">MATRIX / SEARCH</div><h1>{words(locale,'全站搜索','Search')}</h1><p class="lead">{words(locale,'搜索事件、项目、趋势和研究专题。','Search events, projects, trends and research topics.')}</p></header>
<form class="universal-search" role="search"><label for="universal-query">{words(locale,'关键词','Keywords')}</label><input id="universal-query" type="search" placeholder={words(locale,'例如：MCP、量化、agent memory','For example: MCP, quantization, agent memory')} autocomplete="off"/><button class="quiet-button" type="submit">{words(locale,'搜索','Search')}</button></form>
<p id="search-status" role="status">{words(locale,'输入关键词，查看所有类型的相关内容。','Enter keywords to find related content across the archive.')}</p><div id="search-results" data-index={u('/data/search.json')} data-root={u('/',locale)}></div><button class="quiet-button" id="search-more" hidden>{words(locale,'再看二十条','Show twenty more')}</button>
</Base>
<script>
const input=document.getElementById('universal-query') as HTMLInputElement;const results=document.getElementById('search-results')!;const status=document.getElementById('search-status')!;const en=document.documentElement.lang==='en';let records:any[]|null=null;let pending:Promise<any[]>|null=null;let limit=20;let revision=0;
const labels:any=en?{event:'Event',project:'Project',trend:'Trend',topic:'Topic'}:{event:'事件',project:'项目',trend:'趋势',topic:'专题'};
function mark(text:string,query:string){const span=document.createElement('span');let pos=0;const lower=text.toLowerCase();let at=lower.indexOf(query);while(at>=0){span.append(document.createTextNode(text.slice(pos,at)));const m=document.createElement('mark');m.textContent=text.slice(at,at+query.length);span.append(m);pos=at+query.length;at=lower.indexOf(query,pos);}span.append(document.createTextNode(text.slice(pos)));return span;}
async function search(){const turn=++revision;const q=input.value.trim().toLowerCase();results.replaceChildren();document.getElementById('search-more')!.hidden=true;if(!q){status.textContent=en?'Enter a keyword.':'请输入关键词。';return;}status.textContent=en?'Searching…':'正在搜索…';try{if(!records){pending??=fetch(results.dataset.index!).then(r=>{if(!r.ok)throw Error();return r.json();});records=await pending;}if(turn!==revision)return;const list=records!.filter(r=>[r.title_zh,r.title_en,r.summary_zh,r.summary_en].some(v=>(v||'').toLowerCase().includes(q)));for(const r of list.slice(0,limit)){const article=document.createElement('article');article.className='insight-row';const meta=document.createElement('div');meta.className='eyebrow';meta.textContent=`${labels[r.type]} · ${r.date||''}`;const h=document.createElement('h2');const a=document.createElement('a');if(!/^\/(events|projects|trends|topics)\/[\w-]+\/$/.test(r.path))continue;a.href=results.dataset.root+r.path.slice(1);a.append(mark(r[en?'title_en':'title_zh'],q));h.append(a);const p=document.createElement('p');const summary=r[en?'summary_en':'summary_zh']||'';const at=summary.toLowerCase().indexOf(q);const start=Math.max(0,at-70);p.append(mark((start?'…':'')+summary.slice(start,start+240)+(summary.length>start+240?'…':''),q));article.append(meta,h,p);results.append(article);}status.textContent=`${list.length} ${en?'results':'条结果'}`;document.getElementById('search-more')!.hidden=list.length<=limit;}catch{pending=null;if(turn===revision)status.textContent=en?'Search index could not be loaded. Try again.':'搜索索引暂时无法读取，请重试。';}}
document.querySelector('.universal-search')!.addEventListener('submit',ev=>{ev.preventDefault();limit=20;search();});let timer:ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{limit=20;search();},180);});document.getElementById('search-more')?.addEventListener('click',()=>{limit+=20;search();});input.value=new URLSearchParams(location.search).get('q')||'';if(input.value)search();
</script>
