---
import Base from '../../layouts/Base.astro';
import ReaderActions from '../ReaderActions.astro';
import SourceLinks from '../SourceLinks.astro';
import RecBadge from '../RecBadge.astro';
import events from '../../data/generated/events.json';
import {intel,pick,words,changeLabel} from '../../lib/intelligence';
import {u,fmtDate} from '../../lib/url';
import {feedPath} from '../../lib/feeds';
import {splitLead} from '../../lib/reader-store.mjs';
const {locale='zh',project:p}=Astro.props;
const byId:any=Object.fromEntries(events.map((e:any)=>[e.event_id,e]));
const title=(e:any)=>locale==='zh'?e.title_zh:e.title;
const j=p.judgment;
const basis:any=byId[p.basis_event_id];
// Until a judgment is written, show the first sentence of the basis event's reasoning and say where it comes from.
const fallback=basis?splitLead(pick(basis,'why_it_matters',locale))[0]:'';
const nextAction=j?pick(j,'next_action',locale):(basis?pick(basis,'next_action',locale):'');
const basisEvents=(j?.basis_event_ids||[p.basis_event_id]).map((id:string)=>byId[id]).filter(Boolean);
// One timeline: every recorded change to the project's events, newest occurrence first.
const timeline=intel.changes.filter((c:any)=>c.object_type==='event'&&p.event_ids.includes(c.object_id)).sort((a:any,b:any)=>String(b.occurred_at).localeCompare(String(a.occurred_at)));
const tech=locale==='zh'?basis?.technical_details_zh:basis?.technical_details;
const availability=Object.entries(tech||{}).filter(([k])=>/可用|开放|部署|许可|成本|定价|availability|licens|pricing|deploy/i.test(k));
const reviews=intel.reviews.filter((r:any)=>p.event_ids.includes(r.event_id)&&(r.status==='pending'||r.next_review_at));
---
<Base title={pick(p,'name',locale)} locale={locale}>
<header class="editorial-head"><a class="eyebrow" href={u('/projects/',locale)}>← {words(locale,'项目档案','PROJECTS')}</a>
 <h1>{pick(p,'name',locale)} {p.recommendation&&<RecBadge rec={p.recommendation} locale={locale}/>}</h1>
 <p class="lead">{j?pick(j,'judgment',locale):fallback}</p>
 {nextAction&&<p class="brief-action"><span>{words(locale,'建议动作','Next step')}</span>{nextAction}</p>}
 {j?<p class="judgment-meta">{words(locale,'判断复核于','Judgment reviewed')} {fmtDate(j.reviewed_at)} · {words(locale,'依据：','Basis: ')}{basisEvents.map((e:any,i:number)=><>{i>0&&'、'}<a href={u(`/events/${e.event_id}/`,locale)}>{title(e)}</a></>)}</p>
  :<p class="judgment-pending">{words(locale,'这份档案还没有单独撰写的当前判断。上面的等级和说明取自最相关的一条事件，下次扫描涉及这个项目时会补写。','No project-level judgment has been written yet. The rating and text above come from its most relevant event and will be replaced the next time a scan touches this project.')}</p>}
 <ReaderActions locale={locale} follow={`project:${p.id}`} bookmark={`project:${p.id}`} feed={feedPath({type:'project',id:p.id},locale)}/>
</header>
<div class="research-grid"><div>
 {availability.length>0&&<section class="reading-section"><h2>{words(locale,'可用性与采用条件','Availability & adoption')}</h2><dl class="fact-list">{availability.map(([k,v])=><div><dt>{k}</dt><dd>{typeof v==='object'?JSON.stringify(v):String(v)}</dd></div>)}</dl></section>}
 <section class="reading-section"><h2>{words(locale,'时间线','Timeline')}</h2><div class="timeline">{timeline.map((c:any)=>{const e=byId[c.object_id];const [lead,rest]=c.kind==='new'?[title(e),'']:splitLead(pick(c,'summary',locale));return <article><time>{fmtDate(c.occurred_at)}</time><span class="timeline-kind">{changeLabel(c.kind,locale)}</span><h3><a href={u(`/events/${c.object_id}/`,locale)}>{lead}</a></h3>{rest&&<p>{rest}</p>}{c.kind!=='new'&&<p class="judgment-meta">{words(locale,'原事件：','Original story: ')}{title(e)}</p>}<SourceLinks ids={(c.source_ids?.length?c.source_ids:e.source_ids).slice(0,1)} compact locale={locale}/></article>})}</div></section>
 <div class="scenario-links">{p.scenario_ids.map((id:string)=>{const s=intel.scenarios.find((s:any)=>s.id===id);return <a href={u(`/following/?scenario=${id}`,locale)}>{pick(s,'name',locale)} →</a>})}</div>
</div><aside class="research-aside"><section><h2>{words(locale,'外部资源','External resources')}</h2><SourceLinks ids={[...new Set([...(p.official_source_ids||[]),...(basis?.source_ids||[])])].slice(0,6)} locale={locale}/><p>{words(locale,'档案复核','Record reviewed')} · {(p.last_reviewed_at?fmtDate(p.last_reviewed_at):null)||words(locale,'未记录','Not recorded')}</p></section>
<section><h2>{words(locale,'下一观察点','What to check next')}</h2><p>{words(locale,'后续复核关注可用阶段、公开产物和独立验证。没有新证据时不会自动提高建议等级。','Follow-ups check availability, public artifacts and independent evidence. Recommendations do not improve without new evidence.')}</p>{reviews.length>0?<p>{reviews.length} {words(locale,'项复核待处理；排队不代表已经核验。','pending checks. Queued does not mean verified.')}</p>:<p>{words(locale,'当前没有排队中的复核。','No follow-up is currently queued.')}</p>}</section>
</aside></div>
</Base>
