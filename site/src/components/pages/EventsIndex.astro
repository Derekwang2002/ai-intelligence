---
import Base from '../../layouts/Base.astro';
import EventCard from '../EventCard.astro';
import { t, catLabel, type Locale } from '../../lib/i18n';
import events from '../../data/generated/events.json';
import aggregates from '../../data/generated/aggregates.json';

interface Props {
  locale?: Locale;
}
const { locale = 'zh' } = Astro.props;

const groups = new Map<string, any[]>();
for (const e of events) {
  if (!groups.has(e.published_date)) groups.set(e.published_date, []);
  groups.get(e.published_date)!.push(e);
}
const dateGroups = [...groups.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const categories = Object.keys(aggregates.byCategory).sort();
const orgs = aggregates.byOrg.slice(0, 20);
const recCounts = ['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'].map((r) => ({
  r,
  n: (aggregates.byRecommendation as any)[r] ?? 0,
}));
---

<Base title={t(locale, 'events.title')} description={t(locale, 'events.description')} locale={locale}>
  <div class="page-head">
    <div class="head-row">
      <h1>{t(locale, 'events.title')}</h1>
      <span class="en">{t(locale, 'events.en')}</span>
    </div>
    <p class="desc">
      {t(locale, 'events.descPre')}<code>{aggregates.totals.events}</code>{t(locale, 'events.descPost')}
    </p>
  </div>

  <div class="filter-bar" role="search">
    <input type="search" id="f-search" placeholder={t(locale, 'events.searchPlaceholder')} aria-label={t(locale, 'events.searchAria')} />
    <select id="f-cat" aria-label={t(locale, 'events.catAria')}>
      <option value="">{t(locale, 'events.allCats')}</option>
      {categories.map((c) => <option value={c}>{catLabel(c, locale)}（{(aggregates.byCategory as any)[c]}）</option>)}
    </select>
    <select id="f-org" aria-label={t(locale, 'events.orgAria')}>
      <option value="">{t(locale, 'events.allOrgs')}</option>
      {orgs.map((o: any) => <option value={o.name}>{o.name}（{o.count}）</option>)}
    </select>
    <div class="filter-chips" id="f-rec-chips" role="group" aria-label={t(locale, 'events.recAria')}>
      <button type="button" class="fchip active" data-rec="">{t(locale, 'events.all')} <span class="n">{aggregates.totals.events}</span></button>
      {recCounts.map(({ r, n }) => (
        <button type="button" class="fchip" data-rec={r}>{r} <span class="n">{n}</span></button>
      ))}
    </div>
    <span class="filter-count" id="f-count" aria-live="polite" data-suffix={t(locale, 'events.countSuffix')}></span>
  </div>

  <div id="event-list">
    {dateGroups.map(([date, list]) => (
      <section data-group={date}>
        <div class="date-group">
          <h2>{date}</h2>
          <span class="line"></span>
          <span class="n">{list.length} {t(locale, 'events.countUnit')}</span>
        </div>
        <div>
          {list.map((e) => <EventCard event={e} locale={locale} />)}
        </div>
      </section>
    ))}
  </div>

  <div class="filter-empty" id="empty-hint" hidden>{t(locale, 'events.empty')}</div>
</Base>

<script>
  const search = document.getElementById('f-search') as HTMLInputElement;
  const cat = document.getElementById('f-cat') as HTMLSelectElement;
  const org = document.getElementById('f-org') as HTMLSelectElement;
  const chipsWrap = document.getElementById('f-rec-chips');
  const count = document.getElementById('f-count');
  const list = document.getElementById('event-list');
  const empty = document.getElementById('empty-hint');
  let rec = '';

  if (search && cat && org && chipsWrap && list) {
    // 关键词高亮：缓存原始文本，匹配片段包 <mark>，清空搜索时还原
    const origText = new WeakMap<HTMLElement, string>();
    const escHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const markHtml = (text: string, re: RegExp) => {
      let out = '';
      let last = 0;
      for (const m of text.matchAll(re)) {
        out += `${escHtml(text.slice(last, m.index))}<mark>${escHtml(m[0])}</mark>`;
        last = m.index + m[0].length;
      }
      return out + escHtml(text.slice(last));
    };

    const paint = (card: HTMLElement, raw: string) => {
      const re = raw ? new RegExp(escRe(raw), 'gi') : null;
      const q = raw.toLowerCase();
      for (const el of card.querySelectorAll<HTMLElement>('h3, .summary, .bottom .tag:not(.tag-more)')) {
        if (!origText.has(el)) origText.set(el, el.textContent ?? '');
        const text = origText.get(el)!;
        if (!re) {
          el.textContent = text;
        } else {
          el.innerHTML = markHtml(text, re);
        }
        // 摘要命中时取消行数截断，避免高亮被藏进折叠部分
        if (el.classList.contains('summary')) {
          el.classList.toggle('has-hit', !!re && text.toLowerCase().includes(q));
        }
      }
      // 命中的被折叠标签（+N）展开为高亮芯片，让“为什么搜到它”可见
      for (const stale of card.querySelectorAll('.tag-hit')) stale.remove();
      if (re) {
        const more = card.querySelector<HTMLElement>('.bottom .tag-more');
        const items = (more?.dataset.more ?? '').split('|').filter(Boolean);
        let anchor = more;
        for (const item of items) {
          if (!item.toLowerCase().includes(q)) continue;
          const hit = document.createElement('span');
          hit.className = 'tag tag-hit';
          hit.innerHTML = markHtml(item, re);
          anchor?.after(hit);
          anchor = hit;
        }
      }
    };

    const apply = () => {
      const raw = search.value.trim();
      const q = raw.toLowerCase();
      let visible = 0;
      let total = 0;
      for (const card of list.querySelectorAll<HTMLElement>('.event-card')) {
        total++;
        const ok =
          (!q || (card.dataset.q ?? '').includes(q)) &&
          (!cat.value || card.dataset.cat === cat.value) &&
          (!org.value || (card.dataset.org ?? '').split('|').includes(org.value)) &&
          (!rec || card.dataset.rec === rec);
        card.hidden = !ok;
        paint(card, ok ? raw : '');
        if (ok) visible++;
      }
      for (const group of list.querySelectorAll('[data-group]')) {
        const anyVisible = [...group.querySelectorAll('.event-card')].some((c) => !(c as HTMLElement).hidden);
        (group as HTMLElement).hidden = !anyVisible;
      }
      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = `${visible} / ${total} ${count.dataset.suffix ?? ''}`.trim();
    };
    for (const el of [search, cat, org]) el.addEventListener('input', apply);
    chipsWrap.addEventListener('click', (ev) => {
      const chip = (ev.target as HTMLElement).closest<HTMLElement>('.fchip');
      if (!chip) return;
      rec = chip.dataset.rec ?? '';
      for (const c of chipsWrap.querySelectorAll('.fchip')) c.classList.toggle('active', c === chip);
      apply();
    });
    apply();
  }
</script>
