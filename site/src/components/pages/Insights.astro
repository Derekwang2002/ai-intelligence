---
import Base from '../../layouts/Base.astro';
import RadarChart from '../RadarChart.astro';
import ReaderActions from '../ReaderActions.astro';
import {intel,pick,words,trendStatus,confidenceLabel} from '../../lib/intelligence';
import {u,fmtDate} from '../../lib/url';
import events from '../../data/generated/events.json';
import archives from '../../data/generated/trends.json';
const {locale='zh'}=Astro.props;
const active=intel.trends.filter((t:any)=>!t.retired);
---
<Base title={words(locale,'洞察','Insights')} locale={locale}>
<header class="editorial-head"><div class="eyebrow">MATRIX / INSIGHTS</div><h1>{words(locale,'洞察','Insights')}</h1><p class="lead">{words(locale,'判断来自持续积累的证据，也会随着新证据而改变。','Judgments emerge from accumulated evidence, and change when the evidence does.')}</p></header>
<nav class="section-tabs" aria-label={words(locale,'洞察视图','Insight views')}><a href="#trends">{words(locale,'趋势','Trends')}</a><a href="#radar">{words(locale,'技术雷达','Tech radar')}</a><a href="#topics">{words(locale,'研究专题','Research topics')}</a></nav>
<section id="trends" data-insight-panel><div class="section-heading"><h2>{words(locale,'趋势追踪','Tracked trends')}</h2><span>{active.length} {words(locale,'条趋势','trends')}</span></div>
<div class="insight-list">{active.map((t:any)=><article class="insight-row"><div class="eyebrow">{trendStatus(t.status,locale)} · {words(locale,'置信度','Confidence')} {confidenceLabel(t.confidence,locale)}</div><h2><a href={u(`/trends/${t.id}/`,locale)}>{pick(t,'name',locale)}</a></h2><p>{pick(t,'why_it_matters',locale)}</p><p class="muted">{words(locale,'本期复核：','Latest review: ')}{pick(t.updates?.at(-1),'note',locale)}</p><div class="insight-meta"><span>{words(locale,'最近实质更新','Last material update')} {t.last_updated}</span><ReaderActions locale={locale} follow={`trend:${t.id}`}/></div><details class="matrix-fold"><summary>{words(locale,'关键证据','Key evidence')} · {(t.evidence||[]).length}</summary><div class="fold-body"><ul>{(t.evidence||[]).slice(-3).map((e:any)=><li>{pick(e,'claim',locale)} <a href={u(`/trends/${t.id}/#${e.id}`,locale)}>{words(locale,'查看依据','See evidence')} →</a></li>)}</ul>{!t.evidence?.length&&<p>{words(locale,'旧证据尚未完成结构化关联，详情中保留原始记录。','Historical evidence has not yet been linked; original records remain available.')}</p>}</div></details><a class="text-link" href={u(`/trends/${t.id}/`,locale)}>{words(locale,'判断、反证与历史','Judgment, counter-evidence & history')} →</a></article>)}</div>
<details class="matrix-fold preference-fold"><summary>{words(locale,'历史快照与已归档趋势','Snapshots & retired trends')}</summary><div class="fold-body"><div class="archive-links">{archives.snapshots.map((s:any)=><a href={u(`/trends/archive/${s.date}/`,locale)}>{s.date}</a>)}</div>{intel.trends.filter((t:any)=>t.retired).map((t:any)=><p><a href={u(`/trends/${t.id}/`,locale)}>{pick(t,'name',locale)}</a> · {trendStatus(t.status,locale)}</p>)}</div></details></section>
<section id="radar" data-insight-panel><div class="section-heading"><h2>{words(locale,'技术雷达','Tech radar')}</h2></div><p class="muted">{words(locale,'展示资料截至日近 30 天有实质活动的代表条目。完整事件保留在事件库；采用建议仍需结合自己的场景。','Representative entries active in the 30 days before the data cutoff. The event library retains the full archive; apply recommendations in your own context.')}</p><RadarChart events={events} locale={locale}/></section>
<section id="topics" data-insight-panel><div class="section-heading"><h2>{words(locale,'研究专题','Research topics')}</h2></div>{intel.topics.map((t:any)=><article class="insight-row"><div class="eyebrow">{words(locale,'持续研究','LIVING RESEARCH')} · {fmtDate(t.as_of)}</div><h2><a href={u(`/topics/${t.id}/`,locale)}>{pick(t,'question',locale)}</a></h2><p>{pick(t,'answer',locale)}</p><ReaderActions locale={locale} follow={`topic:${t.id}`}/><a class="text-link" href={u(`/topics/${t.id}/`,locale)}>{words(locale,'阅读证据与开放问题','Evidence & open questions')} →</a></article>)}</section>
</Base>
<script>
const tabs=[...document.querySelectorAll<HTMLAnchorElement>('.section-tabs a')];function show(){const id=['trends','radar','topics'].includes(location.hash.slice(1))?location.hash.slice(1):'trends';document.querySelectorAll<HTMLElement>('[data-insight-panel]').forEach(p=>p.hidden=p.id!==id);tabs.forEach(a=>{if(a.hash===`#${id}`)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current');});}window.addEventListener('hashchange',show);show();
</script>
