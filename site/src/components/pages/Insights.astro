---
import Base from '../../layouts/Base.astro';
import RadarChart from '../RadarChart.astro';
import { u } from '../../lib/url';
import { t, loc, locTitle, type Locale } from '../../lib/i18n';
import { QUADRANTS } from '../../lib/quadrants';
import { shortLabel } from '../../lib/shortLabel';
import { selectRadar } from '../../lib/radar';
import events from '../../data/generated/events.json';
import trends from '../../data/generated/trends.json';

interface Props {
  locale?: Locale;
}
const { locale = 'zh' } = Astro.props;

const active = trends.trends.filter((tr: any) => !tr.retired);
const retired = trends.trends.filter((tr: any) => tr.retired);
const lifecycle = ['candidate', 'emerging', 'strengthening', 'established', 'weakening', 'invalidated'];
const uniqueCount = new Set(events.map((e: any) => e.event_fingerprint)).size;
// 雷达上图条数：与 RadarChart 共用同一套窗口/上限逻辑，保证计数与图一致
const radarSel = selectRadar(events);

// 领域 × 日期矩阵：行 = 日期降序，列 = 四象限。防膨胀两层压缩：
// 构建期只保留近 MX_WINDOW_DAYS 天（锚定数据集中最新发布日，构建可复现），更早的收口到事件库；
// 页面上按 MX_CHUNK 天一段渐进展开（客户端小脚本），首屏不被长表淹没。
const MX_WINDOW_DAYS = 30;
const MX_CHUNK = 10;
const maxPub = events.map((e: any) => String(e.published_date)).sort().at(-1) ?? '1970-01-01';
const mxCutoff = new Date(new Date(`${maxPub}T00:00:00Z`).getTime() - (MX_WINDOW_DAYS - 1) * 86400000)
  .toISOString()
  .slice(0, 10);
const mxGroups = new Map<string, any[]>();
for (const e of events) {
  if (String(e.published_date) < mxCutoff) continue;
  if (!mxGroups.has(e.published_date)) mxGroups.set(e.published_date, []);
  mxGroups.get(e.published_date)!.push(e);
}
const dateGroups = [...mxGroups.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const mxHasOlder = events.some((e: any) => String(e.published_date) < mxCutoff);
// 每段的行数（供"再显示 N 天"按钮逐段扣减）
const mxChunks: number[] = [];
for (let i = 0; i < dateGroups.length; i++) mxChunks[Math.floor(i / MX_CHUNK)] = (mxChunks[Math.floor(i / MX_CHUNK)] ?? 0) + 1;
const REC_VAR: Record<string, string> = {
  ADOPT: 'var(--adopt)',
  TRIAL: 'var(--trial)',
  WATCH: 'var(--watch)',
  IGNORE: 'var(--ignore)',
};

function evidenceList(tr: any, loc_: Locale): string[] {
  const items = loc_ === 'zh' ? tr.evidence_zh : tr.evidence_en;
  return (items ?? []).filter(Boolean);
}

// 历史快照按月份分组成日历格：有快照的日期才可点击，避免逐行重复"查看快照"链接
const snapDates = new Set<string>(trends.snapshots.map((s: any) => s.date));
const monthKeys = [...new Set(trends.snapshots.map((s: any) => String(s.date).slice(0, 7)))].sort().reverse();
const WEEKDAYS = locale === 'zh'
  ? ['一', '二', '三', '四', '五', '六', '日']
  : ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const snapMonths = monthKeys.map((mk) => {
  const [y, mo] = mk.split('-').map(Number);
  const offset = (new Date(y, mo - 1, 1).getDay() + 6) % 7; // 周一开头
  const days = new Date(y, mo, 0).getDate();
  const cells: ({ day: number; date: string; has: boolean } | null)[] = Array(offset).fill(null);
  for (let d = 1; d <= days; d++) {
    const date = `${mk}-${String(d).padStart(2, '0')}`;
    cells.push({ day: d, date, has: snapDates.has(date) });
  }
  const label = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long' }).format(new Date(y, mo - 1, 1));
  return { label, cells };
});
---

<Base title={t(locale, 'insights.title')} description={t(locale, 'insights.description')} locale={locale}>
  <div class="page-head">
    <div class="head-row">
      <h1>{t(locale, 'insights.title')}</h1>
      <span class="en">{t(locale, 'insights.en')}</span>
    </div>
    <p class="desc">
      {t(locale, 'insights.desc')}
      <code>{active.length}</code>{t(locale, 'insights.meta1')}<code>{uniqueCount}</code>{t(locale, 'insights.meta2')}<code>{trends.asOf}</code>
    </p>
    <nav class="ins-anchors" aria-label={t(locale, 'insights.sec.aria')}>
      <a class="fchip" href="#trends">{t(locale, 'insights.anchor.trends')}</a>
      <a class="fchip" href="#radar">{t(locale, 'insights.anchor.radar')}</a>
    </nav>
  </div>

  <section class="ins-sec" id="trends">
    <div class="section-title has-extra">
      {t(locale, 'insights.sec.trends')}
      <span class="count">{active.length}</span>
      <span class="lifecycle-steps lc-inline" role="img" aria-label={t(locale, 'trends.lifecycle')}>
        {lifecycle.map((s, i) => (
          <span class="lc-step">
            {i > 0 && <span class="lc-link"></span>}
            <span class={`status-pill st-${s}`}>{s}</span>
          </span>
        ))}
      </span>
    </div>

    <div class="trend-layout">
      <div class="stack">
      {active.map((tr: any) => {
        const note = loc(tr, 'statusNote', locale);
        const showNote = note && note.toLowerCase() !== tr.status;
        return (
          <details class="card trend-card">
            <summary aria-label={t(locale, 'trends.toggle')}>
              <div class="head">
                <h3>{loc(tr, 'name', locale)}</h3>
                <span class={`status-pill st-${tr.status}`}>{tr.status}</span>
                <span class="t-conf">{t(locale, 'trends.confidence')} {tr.confidence}</span>
                <svg class="t-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
              </div>
              <div class="meta">
                {tr.firstObserved && <span>{t(locale, 'trends.firstObserved')} {tr.firstObserved}</span>}
                {tr.lastUpdated && <span>{t(locale, 'trends.lastUpdated')} {tr.lastUpdated}</span>}
              </div>
              {showNote && <div class="block t-note">{note}</div>}
            </summary>
            <div class="trend-detail">
              {loc(tr, 'why', locale) && (
                <div class="block"><b>{t(locale, 'trends.why')}：</b>{loc(tr, 'why', locale)}</div>
              )}
              {evidenceList(tr, locale).length > 0 && (
                <div>
                  <div class="block"><b>{t(locale, 'trends.evidence')}</b></div>
                  <ol class="evidence">
                    {evidenceList(tr, locale).map((item) => <li>{item}</li>)}
                  </ol>
                </div>
              )}
              {(tr.updates ?? []).length > 0 && (
                <div>
                  <div class="block"><b>{t(locale, 'trends.runNotes')}</b></div>
                  <ol class="evidence">
                    {tr.updates.map((up: any) => <li><span class="mono" style="color: var(--text-faint);">{up.date}</span> — {loc(up, 'note', locale)}</li>)}
                  </ol>
                </div>
              )}
              {loc(tr, 'confirm', locale) && (
                <div class="block"><b>{t(locale, 'trends.confirm')}</b>{loc(tr, 'confirm', locale)}</div>
              )}
            </div>
          </details>
        );
      })}
      </div>

      <aside class="trend-rail">
      {trends.snapshots.length > 0 && (
      <div class="trend-sub">
        <h3 class="quad-head">{t(locale, 'insights.archiveSnapshots')}</h3>
        <p class="chart-note" style="text-align: left; margin: 0 2px 14px;">{t(locale, 'insights.archiveSnapNote')}</p>
        <div class="cal-wrap">
        {snapMonths.map((m) => (
          <div class="card cal-block">
            <div class="cal-head">{m.label}</div>
            <div class="cal-grid">
              {WEEKDAYS.map((w) => <span class="cal-wd">{w}</span>)}
              {m.cells.map((c) =>
                c === null ? (
                  <span class="cal-day"></span>
                ) : c.has ? (
                  <a class="cal-day" href={u(`/trends/archive/${c.date}/`, locale)} aria-label={`${c.date} · ${t(locale, 'trends.viewSnapshot').replace(/ →$/, '')}`}>{c.day}</a>
                ) : (
                  <span class="cal-day">{c.day}</span>
                )
              )}
            </div>
          </div>
        ))}
        </div>
      </div>
    )}

    {retired.length > 0 && (
      <div class="trend-sub">
        <h3 class="quad-head">{t(locale, 'insights.archiveRetired')}</h3>
        <div class="stack">
          {retired.map((tr: any) => (
            <article class="card trend-card" style="opacity: 0.68;">
              <div class="head" style="padding: 16px 24px;">
                <h3>{loc(tr, 'name', locale)}</h3>
                <span class={`status-pill st-${tr.status}`}>{tr.status}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
      </aside>
    </div>
  </section>

  <section class="ins-sec" id="radar">
    <div class="section-title">
      {t(locale, 'insights.sec.radar')}
      <span class="count">{radarSel.shownTotal}</span>
    </div>
    <p class="sec-intro">{t(locale, 'insights.radarIntro')}</p>
    <RadarChart events={events} locale={locale} />

    <h3 class="quad-head chart-sub">{t(locale, 'insights.matrix')}</h3>
    <div class="card mx-wrap">
      <table class="mx" id="mx-table">
        <thead>
          <tr>
            <th></th>
            {QUADRANTS.map((q) => <th>{t(locale, q.labelKey)}</th>)}
          </tr>
        </thead>
        <tbody>
          {dateGroups.map(([date, list], i) => (
            <tr data-mxpage={Math.floor(i / MX_CHUNK)} class={i >= MX_CHUNK ? 'mx-hide' : ''}>
              <th scope="row">{date}</th>
              {QUADRANTS.map((q) => {
                const cell = list.filter((e) => q.cats.includes(e.category));
                return (
                  <td>
                    {cell.map((e) => (
                      <a class="mx-item" href={u(`/events/${e.event_id}/`, locale)} title={locTitle(e, locale)}>
                        <i class="rec-dot" style={`background: ${REC_VAR[e.recommendation] ?? 'var(--watch)'}`}></i>
                        {shortLabel(e)}
                      </a>
                    ))}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
        {mxHasOlder && (
          <tfoot>
            <tr class={mxChunks.length > 1 ? 'mx-hide' : ''} data-mxpage={Math.max(0, mxChunks.length - 1)}>
              <td class="mx-archive" colspan={QUADRANTS.length + 1}>
                <a href={u('/events/', locale)}>{t(locale, 'insights.matrixArchive')}</a>
              </td>
            </tr>
          </tfoot>
        )}
      </table>
      {mxChunks.length > 1 && (
        <button
          type="button"
          class="btn-more"
          id="mx-more"
          data-chunks={mxChunks.join(',')}
          data-label={t(locale, 'insights.matrixMore')}
        >
          {t(locale, 'insights.matrixMore')
            .replace('{n}', String(mxChunks[1]))
            .replace('{m}', String(dateGroups.length - mxChunks[0]))}
        </button>
      )}
    </div>
  </section>

  <script>
    import { attachFoldAnim } from '../../lib/detailsFold';
    // 趋势卡片展开/折叠：全站统一的非线性动画（AGENTS.md §19），实现在 lib/detailsFold.ts
    attachFoldAnim('details.trend-card', '.trend-detail');
  </script>

  <script>
    // 领域 × 日期矩阵渐进展开：每点一次 reveal 下一段（MX_CHUNK 天），
    // 段数用尽后移除按钮；归档行（tfoot）随最后一段一起出现。
    (() => {
      const btn = document.getElementById('mx-more');
      if (!btn) return;
      const chunks = (btn.dataset.chunks ?? '').split(',').map(Number).filter((n) => n > 0);
      const label = btn.dataset.label ?? '';
      let page = 0;
      btn.addEventListener('click', () => {
        page++;
        for (const tr of document.querySelectorAll<HTMLElement>('#mx-table [data-mxpage]')) {
          if (Number(tr.dataset.mxpage) <= page) tr.classList.remove('mx-hide');
        }
        const rest = chunks.slice(page + 1).reduce((a, b) => a + b, 0);
        if (rest <= 0) {
          btn.remove();
        } else {
          btn.textContent = label.replace('{n}', String(chunks[page + 1])).replace('{m}', String(rest));
        }
      });
    })();
  </script>
</Base>
