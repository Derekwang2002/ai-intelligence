---
import Base from '../../layouts/Base.astro';
import RadarChart from '../RadarChart.astro';
import { u } from '../../lib/url';
import { t, loc, type Locale } from '../../lib/i18n';
import events from '../../data/generated/events.json';
import trends from '../../data/generated/trends.json';

interface Props {
  locale?: Locale;
}
const { locale = 'zh' } = Astro.props;

const active = trends.trends.filter((tr: any) => !tr.retired);
const retired = trends.trends.filter((tr: any) => tr.retired);
const lifecycle = ['candidate', 'emerging', 'strengthening', 'established', 'weakening', 'invalidated'];
const uniqueCount = new Set(events.map((e: any) => e.event_fingerprint)).size;

function evidenceList(tr: any, loc_: Locale): string[] {
  const items = loc_ === 'zh' ? tr.evidence_zh : tr.evidence_en;
  return (items ?? []).filter(Boolean);
}

// 历史快照按月份分组成日历格：有快照的日期才可点击，避免逐行重复"查看快照"链接
const snapDates = new Set<string>(trends.snapshots.map((s: any) => s.date));
const monthKeys = [...new Set(trends.snapshots.map((s: any) => String(s.date).slice(0, 7)))].sort().reverse();
const WEEKDAYS = locale === 'zh'
  ? ['一', '二', '三', '四', '五', '六', '日']
  : ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const snapMonths = monthKeys.map((mk) => {
  const [y, mo] = mk.split('-').map(Number);
  const offset = (new Date(y, mo - 1, 1).getDay() + 6) % 7; // 周一开头
  const days = new Date(y, mo, 0).getDate();
  const cells: ({ day: number; date: string; has: boolean } | null)[] = Array(offset).fill(null);
  for (let d = 1; d <= days; d++) {
    const date = `${mk}-${String(d).padStart(2, '0')}`;
    cells.push({ day: d, date, has: snapDates.has(date) });
  }
  const label = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long' }).format(new Date(y, mo - 1, 1));
  return { label, cells };
});
---

<Base title={t(locale, 'insights.title')} description={t(locale, 'insights.description')} locale={locale}>
  <div class="page-head">
    <div class="head-row">
      <h1>{t(locale, 'insights.title')}</h1>
      <span class="en">{t(locale, 'insights.en')}</span>
    </div>
    <p class="desc">
      {t(locale, 'insights.desc')}
      <code>{active.length}</code>{t(locale, 'insights.meta1')}<code>{uniqueCount}</code>{t(locale, 'insights.meta2')}<code>{trends.asOf}</code>
    </p>
    <nav class="ins-anchors" aria-label={t(locale, 'insights.sec.aria')}>
      <a class="fchip" href="#trends">{t(locale, 'insights.anchor.trends')}</a>
      <a class="fchip" href="#radar">{t(locale, 'insights.anchor.radar')}</a>
      <a class="fchip" href="#archive">{t(locale, 'insights.anchor.archive')}</a>
    </nav>
  </div>

  <section class="ins-sec" id="trends">
    <div class="section-title has-extra">
      {t(locale, 'insights.sec.trends')}
      <span class="count">{active.length}</span>
      <span class="lifecycle-steps lc-inline" role="img" aria-label={t(locale, 'trends.lifecycle')}>
        {lifecycle.map((s, i) => (
          <span class="lc-step">
            {i > 0 && <span class="lc-link"></span>}
            <span class={`status-pill st-${s}`}>{s}</span>
          </span>
        ))}
      </span>
    </div>

    <div class="stack">
      {active.map((tr: any) => {
        const note = loc(tr, 'statusNote', locale);
        const showNote = note && note.toLowerCase() !== tr.status;
        return (
          <details class="card trend-card">
            <summary aria-label={t(locale, 'trends.toggle')}>
              <div class="head">
                <h3>{loc(tr, 'name', locale)}</h3>
                <span class={`status-pill st-${tr.status}`}>{tr.status}</span>
                <span class="t-conf">{t(locale, 'trends.confidence')} {tr.confidence}</span>
                <svg class="t-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
              </div>
              <div class="meta">
                {tr.firstObserved && <span>{t(locale, 'trends.firstObserved')} {tr.firstObserved}</span>}
                {tr.lastUpdated && <span>{t(locale, 'trends.lastUpdated')} {tr.lastUpdated}</span>}
              </div>
              {showNote && <div class="block t-note">{note}</div>}
            </summary>
            <div class="trend-detail">
              {loc(tr, 'why', locale) && (
                <div class="block"><b>{t(locale, 'trends.why')}：</b>{loc(tr, 'why', locale)}</div>
              )}
              {evidenceList(tr, locale).length > 0 && (
                <div>
                  <div class="block"><b>{t(locale, 'trends.evidence')}</b></div>
                  <ol class="evidence">
                    {evidenceList(tr, locale).map((item) => <li>{item}</li>)}
                  </ol>
                </div>
              )}
              {(tr.updates ?? []).length > 0 && (
                <div>
                  <div class="block"><b>{t(locale, 'trends.runNotes')}</b></div>
                  <ol class="evidence">
                    {tr.updates.map((up: any) => <li><span class="mono" style="color: var(--text-faint);">{up.date}</span> — {loc(up, 'note', locale)}</li>)}
                  </ol>
                </div>
              )}
              {loc(tr, 'confirm', locale) && (
                <div class="block"><b>{t(locale, 'trends.confirm')}</b>{loc(tr, 'confirm', locale)}</div>
              )}
            </div>
          </details>
        );
      })}
    </div>
  </section>

  <section class="ins-sec" id="radar">
    <div class="section-title">
      {t(locale, 'insights.sec.radar')}
      <span class="count">{uniqueCount}</span>
    </div>
    <RadarChart events={events} locale={locale} />
  </section>

  <section class="ins-sec" id="archive">
    <div class="section-title">{t(locale, 'insights.sec.archive')}</div>

    {retired.length > 0 && (
      <div class="stack" style="margin-bottom: 30px;">
        {retired.map((tr: any) => (
          <article class="card trend-card" style="opacity: 0.68;">
            <div class="head" style="padding: 16px 24px;">
              <h3>{loc(tr, 'name', locale)}</h3>
              <span class={`status-pill st-${tr.status}`}>{tr.status}</span>
            </div>
          </article>
        ))}
      </div>
    )}

    {trends.snapshots.length > 0 && (
      <div class="cal-wrap">
        {snapMonths.map((m) => (
          <div class="card cal-block">
            <div class="cal-head">{m.label}</div>
            <div class="cal-grid">
              {WEEKDAYS.map((w) => <span class="cal-wd">{w}</span>)}
              {m.cells.map((c) =>
                c === null ? (
                  <span class="cal-day"></span>
                ) : c.has ? (
                  <a class="cal-day" href={u(`/trends/archive/${c.date}/`, locale)} aria-label={`${c.date} · ${t(locale, 'trends.viewSnapshot').replace(/ →$/, '')}`}>{c.day}</a>
                ) : (
                  <span class="cal-day">{c.day}</span>
                )
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <script>
    // 趋势卡片展开/折叠：WAAPI 高度动画，两个方向一致。
    // （纯 CSS 的 ::details-content 过渡在展开方向上依赖较新浏览器，行为不稳定。）
    document.querySelectorAll('details.trend-card').forEach((details) => {
      const summary = details.querySelector('summary');
      const content = details.querySelector('.trend-detail');
      if (!summary || !content) return;
      let anim = null;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      summary.addEventListener('click', (e) => {
        if (reduce) return; // 减少动态效果：保持原生即时开合
        e.preventDefault();
        anim?.cancel();
        const cs = getComputedStyle(content);
        const pt = cs.paddingTop;
        const pb = cs.paddingBottom;
        if (details.open) {
          const h = content.offsetHeight;
          content.style.overflow = 'clip';
          // 高度收拢的同时内容提前淡出：横线不会拖到最后一刻才消失
          anim = content.animate(
            [
              { height: `${h}px`, paddingTop: pt, paddingBottom: pb, opacity: '1' },
              { opacity: '0', offset: 0.55 },
              { height: '0px', paddingTop: '0px', paddingBottom: '0px', opacity: '0' },
            ],
            { duration: 230, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
          );
          anim.onfinish = () => {
            details.open = false;
            content.removeAttribute('style');
          };
        } else {
          // 先把内联高度钉为 0 再开动画：避免 open 后内容以全高闪一帧（抖动来源）
          details.open = true;
          const h = content.offsetHeight;
          content.style.overflow = 'clip';
          content.style.height = '0px';
          content.style.paddingTop = '0px';
          content.style.paddingBottom = '0px';
          // 卡片从腰部拉长，横线与内容随高度一起浮现（opacity 半程到位，避免拖沓）
          anim = content.animate(
            [
              { height: '0px', paddingTop: '0px', paddingBottom: '0px', opacity: '0' },
              { opacity: '1', offset: 0.5 },
              { height: `${h}px`, paddingTop: pt, paddingBottom: pb, opacity: '1' },
            ],
            { duration: 260, easing: 'cubic-bezier(0.2, 0.6, 0.2, 1)' }
          );
          anim.onfinish = () => {
            content.removeAttribute('style');
          };
        }
      });
    });
  </script>
</Base>
