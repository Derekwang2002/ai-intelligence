---
import Base from '../../layouts/Base.astro';
import ReaderActions from '../ReaderActions.astro';
import ChangeFeed from '../ChangeFeed.astro';
import {intel,pick,words} from '../../lib/intelligence';
import {u} from '../../lib/url';
const {locale='zh'}=Astro.props;
---
<Base title={words(locale,'我的关注','Following')} locale={locale}>
<header class="editorial-head"><div class="eyebrow">MATRIX / FOLLOWING</div><h1>{words(locale,'我的关注','Following')}</h1><p class="lead">{words(locale,'关注一个问题、一项工具，或你正在做的事情。全局重大变化也会保留。','Follow a question, a tool, or what you are building. Major developments remain visible.')}</p><p class="muted">{words(locale,'偏好只保存在当前浏览器，不会自动跨设备同步，也不会发送通知。','Preferences stay in this browser, do not sync automatically, and do not send notifications.')}</p></header>
<details class="matrix-fold preference-fold" open><summary>{words(locale,'我的场景与关注','Scenarios & follows')}</summary><div class="fold-body"><div class="scenario-grid">{intel.scenarios.map((s:any)=><article id={`scenario-${s.id}`}><h3>{pick(s,'name',locale)}</h3><p>{pick(s,'description',locale)}</p><ReaderActions locale={locale} follow={`scenario:${s.id}`}/></article>)}</div>
<div class="follow-list">{intel.search.filter((r:any)=>r.type!=='event').map((r:any)=><div data-follow-item={`${r.type}:${r.id}`} hidden><a href={u(r.path,locale)}>{pick(r,'title',locale)}</a><ReaderActions locale={locale} follow={`${r.type}:${r.id}`}/></div>)}<p data-follow-empty>{words(locale,'还没有关注。选择上面的场景，或前往项目、趋势与专题页关注。','No follows yet. Choose a scenario above, or follow a project, trend or topic.')}</p></div></div></details>
<ChangeFeed locale={locale} following/>
<details class="matrix-fold preference-fold"><summary>{words(locale,'我的收藏','Saved reading')}</summary><div class="fold-body"><p data-saved-empty>{words(locale,'收藏的内容会出现在这里。','Saved items will appear here.')}</p><ul class="saved-list">{intel.search.map((r:any)=><li data-saved-item={`${r.type}:${r.id}`} hidden><a href={u(r.path,locale)}>{pick(r,'title',locale)}</a><ReaderActions locale={locale} bookmark={`${r.type}:${r.id}`}/></li>)}</ul></div></details>
<details class="matrix-fold preference-fold"><summary>{words(locale,'阅读数据管理','Manage reading data')}</summary><div class="fold-body"><p>{words(locale,'导入会合并关注、收藏与已读记录。导出文件可用于手动迁移到其他设备。','Import merges follows, bookmarks and read history. Export to move them manually to another device.')}</p><div class="reader-actions"><button class="quiet-button" id="export-reader">{words(locale,'导出记录','Export')}</button><label class="quiet-button file-label">{words(locale,'导入记录','Import')}<input type="file" id="import-reader" accept="application/json"/></label><button class="quiet-button" id="clear-reader">{words(locale,'清空本地记录','Clear local data')}</button></div></div></details>
</Base>
<script>
const scenario=new URLSearchParams(location.search).get('scenario');if(scenario&&/^[a-z-]+$/.test(scenario))document.getElementById(`scenario-${scenario}`)?.scrollIntoView({block:'center'});
</script>
