---
import { u } from '../lib/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'AI Intelligence Radar — Events → Signals → Trends → Decisions 的 AI 技术情报知识库' } = Astro.props;

const navItems = [
  { href: u('/'), label: '概览', match: (p: string) => p === '/' || p === '' },
  { href: u('/events/'), label: '事件', match: (p: string) => p.startsWith('/events') },
  { href: u('/radar/'), label: '技术雷达', match: (p: string) => p.startsWith('/radar') },
  { href: u('/trends/'), label: '趋势', match: (p: string) => p.startsWith('/trends') },
  { href: u('/daily/'), label: '日报', match: (p: string) => p.startsWith('/daily') },
];

const rawBase = (import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '');
const pathname = Astro.url.pathname === rawBase + '/' || Astro.url.pathname === rawBase
  ? '/'
  : Astro.url.pathname.replace(rawBase, '') || '/';
const pageTitle = title ? `${title} · AI Intelligence Radar` : 'AI Intelligence Radar';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href={u('/')}>
          <span class="logo">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
              <circle cx="15" cy="15" r="13" stroke="var(--accent)" stroke-opacity="0.9" stroke-width="1.6" />
              <circle cx="15" cy="15" r="8" stroke="var(--accent)" stroke-opacity="0.45" stroke-width="1.2" />
              <circle cx="15" cy="15" r="3.2" stroke="var(--accent)" stroke-opacity="0.25" stroke-width="1" />
              <circle cx="20.5" cy="9.5" r="2.6" fill="var(--adopt)" />
              <path d="M15 15 L20.5 9.5" stroke="var(--adopt)" stroke-width="1.2" />
            </svg>
          </span>
          <span>AI Intelligence Radar<span class="sub">观察站</span></span>
        </a>
        <nav class="main-nav">
          {navItems.map((item) => (
            <a href={item.href} class={item.match(pathname) ? 'active' : ''}>{item.label}</a>
          ))}
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换浅色 / 深色主题" title="切换浅色 / 深色主题">
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="container page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <div>
          AI Intelligence Radar — 本站由知识库（events / daily / trends）自动构建，push 到 main 后经 GitHub Actions 自动发布。
        </div>
        <div>
          <a href="https://github.com/Derekwang2002/ai-intelligence" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
