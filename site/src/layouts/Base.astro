---
import { u, logicalPath } from '../lib/url';
import { t, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { title, locale = 'zh' } = Astro.props;
const description = Astro.props.description ?? t(locale, 'site.description');

const navItems = [
  { href: u('/daily/', locale), label: t(locale, 'nav.daily'), match: (p: string) => p.startsWith('/daily') },
  { href: u('/events/', locale), label: t(locale, 'nav.events'), match: (p: string) => p.startsWith('/events') },
  { href: u('/radar/', locale), label: t(locale, 'nav.radar'), match: (p: string) => p.startsWith('/radar') },
  { href: u('/trends/', locale), label: t(locale, 'nav.trends'), match: (p: string) => p.startsWith('/trends') },
];

const pathname = logicalPath(Astro.url.pathname);
const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const langSwitchHref = u(pathname, otherLocale);
const pageTitle = title ? `${title} · MATRIX` : t(locale, 'site.titleSuffix');
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang={otherLocale === 'en' ? 'en' : 'zh-CN'} href={langSwitchHref} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        // ?theme=light|dark 可强制指定主题（测试/分享用），否则用手动选择，再否则跟随系统
        const forced = new URLSearchParams(location.search).get('theme');
        const stored = forced === 'light' || forced === 'dark' ? forced : localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href={u('/', locale)}>
          <span class="logo">
            <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
              <g fill="var(--text-faint)">
                <circle cx="14" cy="14" r="4"/><circle cx="32" cy="14" r="4"/>
                <circle cx="14" cy="32" r="4"/><circle cx="32" cy="32" r="4"/><circle cx="50" cy="32" r="4"/>
                <circle cx="14" cy="50" r="4"/><circle cx="32" cy="50" r="4"/><circle cx="50" cy="50" r="4"/>
              </g>
              <circle cx="50" cy="14" r="7.5" fill="var(--accent)"/>
            </svg>
          </span>
          <span class="name">MATRIX</span>
          <span class="sub">AI Intelligence Radar</span>
        </a>
        <nav class="main-nav" aria-label={t(locale, 'nav.aria')}>
          {navItems.map((item) => (
            <a href={item.href} class={item.match(pathname) ? 'active' : ''} aria-current={item.match(pathname) ? 'page' : undefined}>{item.label}</a>
          ))}
          <div class="nav-utils">
            <a class="lang-switch" href={langSwitchHref} hreflang={otherLocale === 'en' ? 'en' : 'zh-CN'} aria-label={t(locale, 'nav.langSwitchAria')}>{t(locale, 'nav.langSwitch')}</a>
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t(locale, 'theme.toggle')} title={t(locale, 'theme.toggle')}>
              <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
              </svg>
              <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main class="container page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <div>
          {t(locale, 'footer.line1')}
        </div>
        <div>
          <a href="https://github.com/Derekwang2002/ai-intelligence" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
