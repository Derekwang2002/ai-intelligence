---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import daily from '../../data/generated/daily.json';
---

<Base title="日报" description="MATRIX：每日中文情报日报">
  <div class="page-head">
    <div class="head-row">
      <h1>日报</h1>
      <span class="en">Daily Briefing</span>
    </div>
    <p class="desc">每日累计的中文情报简报：执行摘要、各领域动态、趋势信号、Tech Radar 变化与观察清单。</p>
  </div>

  <div>
    {daily.map((d: any) => (
      <a class="daily-row" href={u(`/daily/${d.date}/`)}>
        <span class="d-date">{d.date}</span>
        <p class="d-excerpt">{d.excerpt}</p>
        <span class="d-arrow">→</span>
      </a>
    ))}
  </div>
</Base>
