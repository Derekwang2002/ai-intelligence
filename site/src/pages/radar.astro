---
import Base from '../layouts/Base.astro';
import RadarChart from '../components/RadarChart.astro';
import events from '../data/generated/events.json';
import aggregates from '../data/generated/aggregates.json';
---

<Base title="技术雷达" description="AI 情报观察站：ADOPT / TRIAL / WATCH / IGNORE 四环 × 四象限技术雷达">
  <div class="page-head">
    <div class="head-row">
      <h1>技术雷达</h1>
      <span class="en">Tech Radar</span>
    </div>
    <p class="desc">
      每个事件按建议归入内环（<b>ADOPT</b>）到外环（<b>IGNORE</b>），按领域落入四个象限。
      同一技术多次出现时取最新事件。共 <code>{aggregates.totals.events}</code> 个事件、
      <code>{new Set(events.map((e: any) => e.event_fingerprint)).size}</code> 个独立条目。
      悬停查看详情，点击进入事件页。
    </p>
  </div>
  <RadarChart events={events} />
</Base>
