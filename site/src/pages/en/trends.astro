---
// Trends page merged into the homepage (insights section); keep the old path as a redirect
// (GitHub Pages has no server-side 301, so use a meta refresh).
import { u } from '../../lib/url';
const target = u('/#trends', 'en');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Moved · Home</title>
  </head>
  <body>
    <p>The trends board is now part of the <a href={target}>homepage</a>.</p>
  </body>
</html>
