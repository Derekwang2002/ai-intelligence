---
import Base from '../../layouts/Base.astro';
import RecBadge from '../../components/RecBadge.astro';
import ScoreBars from '../../components/ScoreBars.astro';
import DetailTable from '../../components/DetailTable.astro';
import { u, catLabel, CATEGORY_VARS, fmtDateTime } from '../../lib/url';
import events from '../../data/generated/events.json';

export function getStaticPaths() {
  return events.map((event: any) => ({ params: { id: event.event_id }, props: { event } }));
}

const { event } = Astro.props;
const catVar = CATEGORY_VARS[event.category] ?? 'var(--text-faint)';
const updateKeys = Object.keys(event).filter((k) => /^update_/.test(k));
const idx = events.findIndex((e: any) => e.event_id === event.event_id);
const newer = idx > 0 ? events[idx - 1] : null;
const older = idx >= 0 && idx < events.length - 1 ? events[idx + 1] : null;
const recHint: Record<string, string> = {
  ADOPT: '成熟、价值明确，可以实际采用',
  TRIAL: '值得进行 POC 或小规模实验',
  WATCH: '值得持续跟踪，暂不投入较多资源',
  IGNORE: '当前信号不足、价值有限或 hype 较重',
};
---

<Base title={event.title.slice(0, 80)}>
  <div class="article-head card">
    <div class="crumbs">
      <a href={u('/events/')}>← 事件</a>
      <span class="cat-chip" style={`--cat-c: ${catVar}`}>{catLabel(event.category)}</span>
      <span class="mono" style="font-size: 12px;">{event.event_id}</span>
    </div>
    <h1>{event.title}</h1>
    <div class="meta-row">
      <span class="mono" style="font-size: 12.5px;">{event.published_at}</span>
      {(event.organization ?? []).map((o: string) => <span class="tag">{o}</span>)}
      <RecBadge rec={event.recommendation} />
      <span style="color: var(--text-faint); font-size: 12.5px;">{recHint[event.recommendation]}</span>
    </div>
  </div>

  <div class="detail-grid">
    <div style="display: flex; flex-direction: column; gap: 18px; min-width: 0;">
      <div class="card article-body">
        <div class="section-title" style="margin-top: 22px;">摘要</div>
        <p style="margin: 0; color: var(--text); font-size: 15px; line-height: 1.9;">{event.summary}</p>

        {event.why_it_matters && (
          <>
            <div class="section-title">为什么重要</div>
            <blockquote style="margin: 0; padding: 12px 18px; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 10px 10px 0; color: var(--text); font-size: 14.5px; line-height: 1.85;">
              {event.why_it_matters}
            </blockquote>
          </>
        )}

        {event.technical_details && Object.keys(event.technical_details).length > 0 && (
          <>
            <div class="section-title">技术细节</div>
            <DetailTable obj={event.technical_details} />
          </>
        )}

        {updateKeys.length > 0 && (
          <>
            <div class="section-title">后续更新</div>
            <div style="display: flex; flex-direction: column; gap: 9px;">
              {updateKeys.map((k) => (
                <div style="padding: 11px 16px; font-size: 13.5px; color: var(--text-muted); line-height: 1.8; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px;">
                  <span class="mono" style="color: var(--text-faint); margin-right: 8px; font-size: 11.5px;">{k.replace(/^update_/, '').replace(/_/g, '-')}</span>
                  {event[k]}
                </div>
              ))}
            </div>
          </>
        )}

        {(event.tags ?? []).length > 0 && (
          <>
            <div class="section-title">标签</div>
            <div style="display: flex; flex-wrap: wrap; gap: 7px 14px;">
              {event.tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          </>
        )}
      </div>
    </div>

    <div class="side-stack">
      <div class="card side-box">
        <h3>评分 · {event.recommendation}</h3>
        <ScoreBars scores={event} />
      </div>

      <div class="card side-box">
        <h3>来源</h3>
        <div class="src-list">
          {event.primary_source && (
            <div class="src">
              <span class="tag-tier tag-primary">PRIMARY</span>
              <a href={event.primary_source} target="_blank" rel="noopener">{event.primary_source}</a>
            </div>
          )}
          {(event.secondary_sources ?? []).map((s: string) => (
            <div class="src">
              <span class="tag-tier tag-secondary">SEC</span>
              <a href={s} target="_blank" rel="noopener">{s}</a>
            </div>
          ))}
        </div>
        {event.source_type && <div style="margin-top: 12px; font-size: 12px; color: var(--text-faint);">来源类型：<span class="mono">{event.source_type}</span></div>}
      </div>

      <div class="card side-box">
        <h3>元信息</h3>
        <table class="kv-table">
          <tr><th>发布时间</th><td class="mono">{event.published_at}</td></tr>
          <tr><th>首次发现</th><td class="mono">{fmtDateTime(event.first_seen_at)}</td></tr>
          <tr><th>最后更新</th><td class="mono">{fmtDateTime(event.last_updated_at)}</td></tr>
          <tr><th>Fingerprint</th><td class="mono" style="font-size: 11px; word-break: break-all;">{event.event_fingerprint}</td></tr>
        </table>
      </div>
    </div>
  </div>

  <nav class="prevnext" aria-label="相邻事件">
    {newer ? (
      <a class="card pn-link" href={u(`/events/${newer.event_id}/`)}>
        <span class="pn-dir">← 较新事件 · {newer.date}</span>
        <span class="pn-title">{newer.title}</span>
      </a>
    ) : <span></span>}
    {older ? (
      <a class="card pn-link next" href={u(`/events/${older.event_id}/`)}>
        <span class="pn-dir">较旧事件 · {older.date} →</span>
        <span class="pn-title">{older.title}</span>
      </a>
    ) : <span></span>}
  </nav>
</Base>
