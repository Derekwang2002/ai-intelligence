---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { catLabel } from '../../lib/url';
import events from '../../data/generated/events.json';
import aggregates from '../../data/generated/aggregates.json';

const groups = new Map<string, any[]>();
for (const e of events) {
  if (!groups.has(e.published_date)) groups.set(e.published_date, []);
  groups.get(e.published_date).push(e);
}
const dateGroups = [...groups.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const categories = Object.keys(aggregates.byCategory).sort();
const orgs = aggregates.byOrg.slice(0, 20);
---

<Base title="事件" description="AI 情报观察站：按时间线浏览全部结构化事件，支持按类别、组织、建议筛选">
  <div class="page-head">
    <div class="head-row">
      <h1>事件</h1>
      <span class="en">Events Timeline</span>
    </div>
    <p class="desc">
      共 <code>{aggregates.totals.events}</code> 个结构化事件，按发布日期归属（非发现时间）。每个事件均经来源验证与去重，
      携带六维评分与采用建议。
    </p>
  </div>

  <div class="filter-bar" role="search">
    <input type="search" id="f-search" placeholder="搜索标题、摘要、组织、标签…" aria-label="搜索事件" />
    <select id="f-cat" aria-label="按类别筛选">
      <option value="">全部类别</option>
      {categories.map((c) => <option value={c}>{catLabel(c)}（{aggregates.byCategory[c]}）</option>)}
    </select>
    <select id="f-org" aria-label="按组织筛选">
      <option value="">全部组织</option>
      {orgs.map((o: any) => <option value={o.name}>{o.name}（{o.count}）</option>)}
    </select>
    <select id="f-rec" aria-label="按建议筛选">
      <option value="">全部建议</option>
      <option value="ADOPT">ADOPT</option>
      <option value="TRIAL">TRIAL</option>
      <option value="WATCH">WATCH</option>
      <option value="IGNORE">IGNORE</option>
    </select>
    <span class="filter-count" id="f-count" aria-live="polite"></span>
  </div>

  <div id="event-list">
    {dateGroups.map(([date, list]) => (
      <section data-group={date}>
        <div class="date-group">
          <h2>{date}</h2>
          <span class="line"></span>
          <span class="n">{list.length} 个事件</span>
        </div>
        <div class="grid grid-2">
          {list.map((e) => <EventCard event={e} />)}
        </div>
      </section>
    ))}
  </div>

  <div class="filter-empty" id="empty-hint" hidden>没有符合筛选条件的事件。可以调整关键词或清除筛选。</div>
</Base>

<script>
  const search = document.getElementById('f-search') as HTMLInputElement;
  const cat = document.getElementById('f-cat') as HTMLSelectElement;
  const org = document.getElementById('f-org') as HTMLSelectElement;
  const rec = document.getElementById('f-rec') as HTMLSelectElement;
  const list = document.getElementById('event-list');
  const empty = document.getElementById('empty-hint');
  const count = document.getElementById('f-count');
  if (search && cat && org && rec && list) {
    const total = list.querySelectorAll('.event-card').length;
    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      for (const card of list.querySelectorAll<HTMLElement>('.event-card')) {
        const ok =
          (!q || (card.dataset.q ?? '').includes(q)) &&
          (!cat.value || card.dataset.cat === cat.value) &&
          (!org.value || (card.dataset.org ?? '').split('|').includes(org.value)) &&
          (!rec.value || card.dataset.rec === rec.value);
        card.hidden = !ok;
        if (ok) visible++;
      }
      for (const group of list.querySelectorAll<HTMLElement>('[data-group]')) {
        const anyVisible = [...group.querySelectorAll('.event-card')].some((c) => !c.hidden);
        group.hidden = !anyVisible;
      }
      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = `${visible} / ${total}`;
    };
    for (const el of [search, cat, org, rec]) el.addEventListener('input', apply);
    apply();
  }
</script>
