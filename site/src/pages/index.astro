---
import Base from '../layouts/Base.astro';
import RecBadge from '../components/RecBadge.astro';
import { u, fmtDateTime, catLabel } from '../lib/url';
import events from '../data/generated/events.json';
import aggregates from '../data/generated/aggregates.json';
import daily from '../data/generated/daily.json';
import trends from '../data/generated/trends.json';
import state from '../data/generated/state.json';

const activeTrends = trends.trends.filter((t: any) => !t.retired);
const latestDaily = daily[0];
const latestEvents = events.slice(0, 6);

// 首页主角是最新日报的执行摘要：从渲染后的 HTML 中截取
// “Daily Executive Summary” 一节；取不到时退化为文本摘要。
function extractExecSummary(html: string): string {
  const m = html.match(/<h2[^>]*>\s*Daily Executive Summary\s*<\/h2>([\s\S]*?)(?=<h2|$)/i);
  if (m) return m[1];
  return '';
}
const execHtml = latestDaily ? extractExecSummary(latestDaily.html) : '';

const recTotal = Object.values(aggregates.byRecommendation).reduce((a: number, b: any) => a + b, 0);
const recSummary = (['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const)
  .map((r) => ({ r, n: aggregates.byRecommendation[r] ?? 0 }))
  .filter((x) => x.n > 0);
---

<Base>
  <section class="hero rise">
    <div class="kicker">AI Intelligence Radar</div>
    <h1>追踪值得工程决策关注的<br />AI 技术变化</h1>
    <p>
      不是新闻聚合器。增量扫描一手来源，把分散的公开信息沉淀为结构化事件、可验证信号与趋势判断，
      每个条目都带有评分与 ADOPT / TRIAL / WATCH / IGNORE 建议。
    </p>
    <div class="hero-cta">
      {latestDaily && <a class="btn-primary" href={u(`/daily/${latestDaily.date}/`)}>读今日简报 →</a>}
      <a class="btn-ghost" href={u('/events/')}>浏览全部事件</a>
    </div>
    <div class="hero-meta">
      最后扫描 {fmtDateTime(state.last_successful_run_at)}（北京时间）· 收录 {aggregates.totals.events} 事件 /
      {aggregates.totals.orgs} 组织 · {activeTrends.length} 条活跃趋势
    </div>
  </section>

  <div class="home-cols">
    <div>
      {latestDaily && (
        <section class="card brief rise-2" aria-label="今日简报摘要">
          <div class="brief-head">
            <span class="brief-date">{latestDaily.date}</span>
            <span class="brief-label">今日简报 · Executive Summary</span>
            <a class="more" href={u(`/daily/${latestDaily.date}/`)}>阅读全文 →</a>
          </div>
          {execHtml
            ? <div class="prose brief-exec" set:html={execHtml} />
            : <p class="prose brief-exec">{latestDaily.excerpt}</p>}
        </section>
      )}

      <div class="section-title rise-2">
        最新事件
        <span class="count">{aggregates.totals.events} 条</span>
        <a class="more" href={u('/events/')}>查看全部 →</a>
      </div>
      <div class="feed rise-2">
        {latestEvents.map((e: any) => (
          <a class="feed-row" href={u(`/events/${e.event_id}/`)}>
            <span class="f-date">{e.published_date}</span>
            <span class="f-main">
              <span class="f-top">
                <span class="cat-chip">{catLabel(e.category)}</span>
                <span class="f-orgs">{(e.organization ?? []).join(' · ')}</span>
              </span>
              <span class="f-title">{e.title}</span>
            </span>
            <span class="f-side">
              <RecBadge rec={e.recommendation} />
              <span class="score-nums" title="技术影响 / 工程价值 / 采用信号">
                影响 {e.technical_impact ?? 0} · 工程 {e.engineering_value ?? 0} · 采用 {e.adoption_signal ?? 0}
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <aside>
      <div class="section-title rise-3">
        活跃趋势
        <a class="more" href={u('/trends/')}>全部 →</a>
      </div>
      <div class="trend-minis rise-3">
        {activeTrends.slice(0, 4).map((t: any) => (
          <a class="t-mini" href={u('/trends/')}>
            <span class="tm-meta">
              <span class={`status-pill st-${t.status}`}>{t.status}</span>
              <span class="tm-date">{t.firstObserved.slice(0, 10)}</span>
            </span>
            <span class="tm-name">{t.name}</span>
          </a>
        ))}
      </div>

      <div class="section-title rise-3">建议分布</div>
      <div class="rec-dist rise-3">
        {recSummary.map(({ r, n }) => (
          <a href={u('/radar/')} title={`查看 ${r} 条目`}>
            <span class={`badge badge-${r.toLowerCase()}`}>{r}</span>
            <span class="track">
              <span class="fill" style={`width: ${(n / recTotal) * 100}%; background: var(--${r.toLowerCase()});`}></span>
            </span>
            <span class="n">{n}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</Base>

<style>
  .home-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
    margin-top: 12px;
  }
  @media (max-width: 940px) {
    .home-cols { grid-template-columns: 1fr; }
  }
</style>
