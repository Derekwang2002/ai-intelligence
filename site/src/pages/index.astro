---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { u, fmtDateTime } from '../lib/url';
import events from '../data/generated/events.json';
import aggregates from '../data/generated/aggregates.json';
import daily from '../data/generated/daily.json';
import trends from '../data/generated/trends.json';
import state from '../data/generated/state.json';

const activeTrends = trends.trends.filter((t: any) => !t.retired);
const latestDaily = daily[0];
const latestEvents = events.slice(0, 5);

// Continuous day range (last 14 days ending at the most recent day with data).
function dayRange(from: string, to: string): string[] {
  const out: string[] = [];
  const d = new Date(`${from}T00:00:00Z`);
  const end = new Date(`${to}T00:00:00Z`);
  while (d <= end && out.length < 40) {
    out.push(d.toISOString().slice(0, 10));
    d.setUTCDate(d.getUTCDate() + 1);
  }
  return out;
}
const lastDay = aggregates.totals.lastDay ?? latestDaily?.date;
const firstDay = aggregates.totals.firstDay ?? lastDay;
const allDays = dayRange(firstDay, lastDay);
const chartDays = allDays.slice(-14);
const maxCount = Math.max(1, ...chartDays.map((d) => aggregates.byDay[d] ?? 0));

const recTotal = Object.values(aggregates.byRecommendation).reduce((a: number, b: any) => a + b, 0);
const recSummary = (['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const)
  .map((r) => ({ r, n: aggregates.byRecommendation[r] ?? 0 }))
  .filter((x) => x.n > 0);
---

<Base>
  <section class="hero rise">
    <div class="kicker">AI Intelligence Radar</div>
    <h1>追踪值得工程决策关注的<br />AI 技术变化</h1>
    <p>
      不是新闻聚合器。增量扫描一手来源，把分散的公开信息沉淀为结构化事件、可验证信号与趋势判断，
      每个条目都带有评分与 ADOPT / TRIAL / WATCH / IGNORE 建议。
    </p>
    <div class="pipeline">
      <span>Events</span><span class="sep">→</span>
      <span>Signals</span><span class="sep">→</span>
      <span>Trends</span><span class="sep">→</span>
      <span>Decisions</span>
    </div>
  </section>

  <section class="grid grid-4 rise-2" style="margin-top: 26px;">
    <div class="card stat">
      <div class="num">{aggregates.totals.events}</div>
      <div class="label">结构化事件</div>
      <div class="detail">{aggregates.totals.days} 天 · {aggregates.totals.tags} 个标签</div>
    </div>
    <div class="card stat">
      <div class="num">{aggregates.totals.orgs}</div>
      <div class="label">追踪中的组织</div>
      <div class="detail">最高频：{aggregates.byOrg[0]?.name ?? '—'}（{aggregates.byOrg[0]?.count ?? 0}）</div>
    </div>
    <div class="card stat">
      <div class="num">{activeTrends.length}</div>
      <div class="label">活跃趋势候选</div>
      <div class="detail">生命周期：candidate → established</div>
    </div>
    <div class="card stat">
      <div class="num" style="font-size: 19px; padding-top: 6px;">{fmtDateTime(state.last_successful_run_at)}</div>
      <div class="label">最后扫描（北京时间）</div>
      <div class="detail">共 {state.total_runs} 次运行</div>
    </div>
  </section>

  <div style="display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 28px; align-items: start;" class="home-cols">
    <div>
      <div class="section-title rise-2">
        最新事件
        <span class="count">{aggregates.totals.events} 条</span>
        <a class="more" href={u('/events/')}>查看全部 →</a>
      </div>
      <div class="grid" style="grid-template-columns: 1fr;">
        {latestEvents.map((e: any) => <EventCard event={e} />)}
      </div>

      {latestDaily && (
        <div class="card" style="padding: 20px 22px; margin-top: 28px;">
          <div class="section-title" style="margin: 0 0 8px;">
            最新日报 · {latestDaily.date}
            <a class="more" href={u(`/daily/${latestDaily.date}/`)}>阅读全文 →</a>
          </div>
          <p style="margin: 0; color: var(--text-muted); font-size: 13.8px; line-height: 1.8;">{latestDaily.excerpt}</p>
        </div>
      )}
    </div>

    <div>
      <div class="section-title rise-3">观察清单</div>
      <div class="card rise-3" style="padding: 6px 20px;">
        <ul class="watch-list" style="margin: 0; padding: 0; list-style: none;">
          {state.next_scan_focus.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="section-title rise-3">
        活跃趋势
        <a class="more" href={u('/trends/')}>全部 →</a>
      </div>
      <div class="grid rise-3">
        {activeTrends.slice(0, 4).map((t: any) => (
          <a class="card trend-card" href={u('/trends/')} style="gap: 8px; padding: 16px 18px;">
            <div class="head" style="margin-bottom: 0;">
              <span class={`status-pill st-${t.status}`}>{t.status}</span>
              <span class="conf-pill">{t.confidence}</span>
            </div>
            <div style="font-weight: 600; font-size: 14px; line-height: 1.6; color: var(--text);">{t.name}</div>
            <div style="font-size: 12px; color: var(--text-faint); font-family: var(--mono);">首次观察 {t.firstObserved.slice(0, 10)} · 更新 {t.lastUpdated.slice(0, 10)}</div>
          </a>
        ))}
      </div>

      <div class="section-title rise-3">事件活动</div>
      <div class="card rise-3" style="padding: 16px 18px 10px;">
        <div class="activity">
          {chartDays.map((d) => {
            const n = aggregates.byDay[d] ?? 0;
            return (
              <div class="col" title={`${d} · ${n} 个事件`}>
                <div class={`bar ${n === 0 ? 'empty' : ''}`} style={`height: ${Math.max(4, (n / maxCount) * 82)}px;`}></div>
                <div class="lbl">{d.slice(5)}</div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="section-title rise-3">建议分布</div>
      <div class="card rise-3" style="padding: 16px 18px; display: flex; flex-direction: column; gap: 10px;">
        {recSummary.map(({ r, n }) => (
          <a href={u('/radar/')} style="display: grid; grid-template-columns: 64px 1fr 40px; gap: 10px; align-items: center; font-size: 12.5px; color: var(--text-muted);">
            <span class={`badge badge-${r.toLowerCase()}`}>{r}</span>
            <span class="track" style="height: 6px; border-radius: 4px; background: var(--surface-3); overflow: hidden; display: block;">
              <span style={`display: block; height: 100%; width: ${(n / recTotal) * 100}%; background: var(--${r.toLowerCase()}); border-radius: 4px;`}></span>
            </span>
            <span class="mono" style="text-align: right;">{n}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  @media (max-width: 940px) {
    .home-cols { grid-template-columns: 1fr !important; }
  }
</style>
