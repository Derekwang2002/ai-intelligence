---
import Base from '../layouts/Base.astro';
import RecBadge from '../components/RecBadge.astro';
import { u, fmtDateTime, catLabel, CATEGORY_VARS } from '../lib/url';
import events from '../data/generated/events.json';
import aggregates from '../data/generated/aggregates.json';
import daily from '../data/generated/daily.json';
import trends from '../data/generated/trends.json';
import state from '../data/generated/state.json';

const activeTrends = trends.trends.filter((t: any) => !t.retired);
const latestDaily = daily[0];
const latestEvents = events.slice(0, 6);

const CONF_LEVEL: Record<string, number> = { High: 3, Medium: 2, Low: 1 };

// Continuous day range (last 14 days ending at the most recent day with data).
function dayRange(from: string, to: string): string[] {
  const out: string[] = [];
  const d = new Date(`${from}T00:00:00Z`);
  const end = new Date(`${to}T00:00:00Z`);
  while (d <= end && out.length < 40) {
    out.push(d.toISOString().slice(0, 10));
    d.setUTCDate(d.getUTCDate() + 1);
  }
  return out;
}
const lastDay = aggregates.totals.lastDay ?? latestDaily?.date;
const firstDay = aggregates.totals.firstDay ?? lastDay;
const allDays = dayRange(firstDay, lastDay);
const chartDays = allDays.slice(-14);
const maxCount = Math.max(1, ...chartDays.map((d) => aggregates.byDay[d] ?? 0));

const recTotal = Object.values(aggregates.byRecommendation).reduce((a: number, b: any) => a + b, 0);
const recSummary = (['ADOPT', 'TRIAL', 'WATCH', 'IGNORE'] as const)
  .map((r) => ({ r, n: aggregates.byRecommendation[r] ?? 0 }))
  .filter((x) => x.n > 0);

const miniDims = [
  { key: 'technical_impact', label: 'TI' },
  { key: 'engineering_value', label: 'EV' },
  { key: 'adoption_signal', label: 'AS' },
];
---

<Base>
  <section class="hero rise">
    <div class="hero-grid">
      <div>
        <div class="kicker">AI Intelligence Radar</div>
        <h1>追踪值得工程决策关注的<br /><span class="grad">AI 技术变化</span></h1>
        <p>
          不是新闻聚合器。增量扫描一手来源，把分散的公开信息沉淀为结构化事件、可验证信号与趋势判断，
          每个条目都带有评分与 ADOPT / TRIAL / WATCH / IGNORE 建议。
        </p>
        <div class="pipeline" aria-label="处理流水线">
          <span>Events</span><span class="sep">→</span>
          <span>Signals</span><span class="sep">→</span>
          <span>Trends</span><span class="sep">→</span>
          <span>Decisions</span>
        </div>
      </div>
      <div class="card status-panel">
        <div class="sp-head">Scanner Status</div>
        <div class="sp-time">{fmtDateTime(state.last_successful_run_at)}</div>
        <div class="sp-sub">最后扫描（北京时间）· 共 {state.total_runs} 次运行</div>
        <div class="sp-rows">
          <div class="sp-row"><span>结构化事件</span><b>{aggregates.totals.events}</b></div>
          <div class="sp-row"><span>追踪组织</span><b>{aggregates.totals.orgs}</b></div>
          <div class="sp-row"><span>活跃趋势</span><b>{activeTrends.length}</b></div>
          <div class="sp-row"><span>覆盖天数 / 标签</span><b>{aggregates.totals.days} 天 · {aggregates.totals.tags}</b></div>
        </div>
      </div>
    </div>
  </section>

  <div class="home-cols">
    <div>
      <div class="section-title rise-2">
        最新事件
        <span class="count">{aggregates.totals.events} 条</span>
        <a class="more" href={u('/events/')}>查看全部 →</a>
      </div>
      <div class="card feed rise-2">
        {latestEvents.map((e: any) => (
          <a class="feed-row" href={u(`/events/${e.event_id}/`)}>
            <span class="f-date">{e.published_date}</span>
            <span class="f-main">
              <span class="f-top">
                <span class="cat-chip" style={`--cat-c: ${CATEGORY_VARS[e.category] ?? 'var(--text-faint)'}`}>{catLabel(e.category)}</span>
                <span class="f-orgs">{(e.organization ?? []).join(' · ')}</span>
              </span>
              <span class="f-title">{e.title}</span>
            </span>
            <span class="f-side">
              <RecBadge rec={e.recommendation} />
              <span class="mini-scores">
                {miniDims.map((d) => (
                  <span class="m" title={d.label}>
                    {d.label}
                    <span class="dots">
                      {[1, 2, 3, 4, 5].map((n) => (
                        <span class={`dot ${n <= (e[d.key] ?? 0) ? 'on' : ''}`}></span>
                      ))}
                    </span>
                  </span>
                ))}
              </span>
            </span>
          </a>
        ))}
      </div>

      {latestDaily && (
        <div class="card daily-feature rise-2" style="margin-top: 24px;">
          <div class="df-head">
            <span class="df-date">{latestDaily.date}</span>
            <span style="font-size: 13px; color: var(--text-faint);">最新日报</span>
            <a class="more" style="margin-left: auto; font-size: 13px;" href={u(`/daily/${latestDaily.date}/`)}>阅读全文 →</a>
          </div>
          <p class="df-excerpt">{latestDaily.excerpt}</p>
        </div>
      )}
    </div>

    <aside>
      <div class="section-title rise-3">观察清单</div>
      <ul class="watch-list rise-3">
        {state.next_scan_focus.map((item: string) => <li>{item}</li>)}
      </ul>

      <div class="section-title rise-3">
        活跃趋势
        <a class="more" href={u('/trends/')}>全部 →</a>
      </div>
      <div class="grid rise-3">
        {activeTrends.slice(0, 4).map((t: any) => (
          <a class="card" href={u('/trends/')} style="gap: 8px; padding: 15px 18px; display: flex; flex-direction: column;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class={`status-pill st-${t.status}`}>{t.status}</span>
              <span class="conf-dots" title={`Confidence ${t.confidence}`} aria-label={`Confidence ${t.confidence}`}>
                {[1, 2, 3].map((n) => (
                  <i class={n <= (CONF_LEVEL[t.confidence] ?? 1) ? 'on' : ''}></i>
                ))}
              </span>
            </div>
            <div style="font-weight: 600; font-size: 14px; line-height: 1.6; color: var(--text);">{t.name}</div>
            <div style="font-size: 11.5px; color: var(--text-faint); font-family: var(--mono);">首次观察 {t.firstObserved.slice(0, 10)}</div>
          </a>
        ))}
      </div>

      <div class="section-title rise-3">事件活动 · 近 14 天</div>
      <div class="activity rise-3" role="img" aria-label="近 14 天事件数量柱状图">
        {chartDays.map((d) => {
          const n = aggregates.byDay[d] ?? 0;
          return (
            <div class="col" title={`${d} · ${n} 个事件`}>
              <div class={`bar ${n === 0 ? 'empty' : ''}`} style={`height: ${Math.max(4, (n / maxCount) * 82)}px;`}></div>
              <div class="lbl">{d.slice(5)}</div>
            </div>
          );
        })}
      </div>

      <div class="section-title rise-3">建议分布</div>
      <div class="rec-dist rise-3">
        {recSummary.map(({ r, n }) => (
          <a href={u('/radar/')} title={`查看 ${r} 条目`}>
            <span class={`badge badge-${r.toLowerCase()}`}>{r}</span>
            <span class="track">
              <span class="fill" style={`width: ${(n / recTotal) * 100}%; background: var(--${r.toLowerCase()});`}></span>
            </span>
            <span class="n">{n}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</Base>

<style>
  .home-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    margin-top: 8px;
  }
  @media (max-width: 940px) {
    .home-cols { grid-template-columns: 1fr; }
  }
</style>
