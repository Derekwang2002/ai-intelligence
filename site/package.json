{
  "name": "ai-intelligence-site",
  "version": "1.0.0",
  "description": "Static reading & observation site for the AI Intelligence Radar knowledge base",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-data.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-data.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node ../scripts/validate-intelligence.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "migrate": "node ../scripts/migrate-intelligence.mjs",
    "check": "npm run validate && npm test && npm run build && npm run check:links",
    "check:links": "node scripts/check-built-links.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "marked": "^15.0.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
